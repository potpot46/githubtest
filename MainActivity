    private void attachUserNotesListener() {
        if (userNotesRef == null || currentUser == null) {
            Log.e(TAG, "Cannot attach user_notes listener: userNotesRef or currentUser is null.");
            updateUIAfterFetchingAllNoteDetails(new ArrayList<>(), 0);
            return;
        }
        Log.d(TAG, "Attaching user_notes listener to: " + userNotesRef.toString());

        if (userNotesListener == null) {
            userNotesListener = new ValueEventListener() {
                @Override
                public void onDataChange(@NonNull DataSnapshot dataSnapshot) {
                    Log.d(TAG, "User_notes onDataChange. Snapshot exists: " + dataSnapshot.exists() + ", Children: " + dataSnapshot.getChildrenCount());
                    List<String> noteIdsFromIndex = new ArrayList<>();
                    if (dataSnapshot.exists()) {
                        for (DataSnapshot noteIdSnapshot : dataSnapshot.getChildren()) {
                            if (Boolean.TRUE.equals(noteIdSnapshot.getValue(Boolean.class)) && noteIdSnapshot.getKey() != null) {
                                noteIdsFromIndex.add(noteIdSnapshot.getKey());
                            }
                        }
                    }
                    Log.d(TAG, "From user_notes: Found " + noteIdsFromIndex.size() + " note IDs.");
                    processDiscoveredNoteIds(noteIdsFromIndex);
                }

                @Override
                public void onCancelled(@NonNull DatabaseError databaseError) {
                    Log.e(TAG, "Failed to load user_notes list.", databaseError.toException());
                    updateUIAfterFetchingAllNoteDetails(new ArrayList<>(), 0);
                    Toast.makeText(MainActivity.this, "Error loading your notes.", Toast.LENGTH_SHORT).show();
                }
            };
            userNotesRef.addValueEventListener(userNotesListener);
        } else {
            Log.d(TAG, "User_notes listener already attached.");
            if (sharedNotesList.isEmpty() && progressBarMain.getVisibility() == View.GONE) {
                Log.d(TAG, "User_notes listener already attached, but list is empty. Forcing visibility update.");
                progressBarMain.setVisibility(View.VISIBLE);
                textViewNoSharedNotes.setVisibility(View.GONE);
                recyclerViewSharedNotes.setVisibility(View.GONE);
            }
        }
    }

    private synchronized void processDiscoveredNoteIds(List<String> newNoteIdsFromUserNotesIndex) {
        Log.d(TAG, "Processing " + newNoteIdsFromUserNotesIndex.size() + " note IDs from user_notes_listener: " + newNoteIdsFromUserNotesIndex);

        Set<String> currentIdsInIndexSet = new HashSet<>(newNoteIdsFromUserNotesIndex);
        List<SharedNoteAdapter.NoteWrapper> notesToRemove = new ArrayList<>();
        boolean listChangedDueToRemoval = false;

        // Iterate over a copy of sharedNotesList to safely remove items
        for (SharedNoteAdapter.NoteWrapper existingWrapper : new ArrayList<>(sharedNotesList)) {
            if (!currentIdsInIndexSet.contains(existingWrapper.noteId)) {
                notesToRemove.add(existingWrapper);
            }
        }

        if (!notesToRemove.isEmpty()) {
            Log.d(TAG, "Removing " + notesToRemove.size() + " stale notes from UI: " + notesToRemove.stream().map(nw -> nw.noteId).collect(Collectors.toList()));
            sharedNotesList.removeAll(notesToRemove);
            // Also remove from processedNoteIds so they can be re-added if they reappear in index
            for(SharedNoteAdapter.NoteWrapper removed : notesToRemove) {
                processedNoteIds.remove(removed.noteId);
            }
            listChangedDueToRemoval = true;
        }

        List<String> notesToFetchDetailsFor = new ArrayList<>();
        for (String noteIdFromIndex : newNoteIdsFromUserNotesIndex) {
            // Check if it's already in processedNoteIds (meaning it's either in sharedNotesList or currently being fetched)
            if (!processedNoteIds.contains(noteIdFromIndex)) {
                notesToFetchDetailsFor.add(noteIdFromIndex);
            }
        }

        if (!notesToFetchDetailsFor.isEmpty()) {
            Log.d(TAG, "Identified " + notesToFetchDetailsFor.size() + " new notes to fetch details for.");
            processedNoteIds.addAll(notesToFetchDetailsFor); // Add to processed before fetching
            fetchAllNoteDetails(notesToFetchDetailsFor, newNoteIdsFromUserNotesIndex.size());
        } else if (listChangedDueToRemoval) {
            // Only removals occurred, update UI with the current (smaller) list
            Log.d(TAG, "No new notes to fetch, but list changed due to removals. Refreshing UI.");
            updateUIAfterFetchingAllNoteDetails(new ArrayList<>(sharedNotesList), newNoteIdsFromUserNotesIndex.size());
        } else if (newNoteIdsFromUserNotesIndex.isEmpty() && sharedNotesList.isEmpty()) {
            Log.d(TAG, "User_notes index is empty and UI list is empty. No notes to display.");
            updateUIAfterFetchingAllNoteDetails(new ArrayList<>(), 0);
        } else {
            Log.d(TAG, "No changes to the note ID list requiring new fetches. Current UI might be up-to-date or just needs sorting.");
            // If the progress bar is visible but the list isn't empty (e.g., after a refresh that found existing items), hide it.
            if (progressBarMain.getVisibility() == View.VISIBLE) {
                updateUIAfterFetchingAllNoteDetails(new ArrayList<>(sharedNotesList), newNoteIdsFromUserNotesIndex.size());
            }
        }
    }


    private void fetchAllNoteDetails(List<String> noteIdsToFetch, int totalNotesInIndex) {
        Log.i(TAG, "fetchAllNoteDetails called for " + noteIdsToFetch.size() + " note IDs: " + noteIdsToFetch.toString());

        if (noteIdsToFetch.isEmpty()) {
            // If there are no new notes to fetch, but the UI might need an update (e.g., after removals or for sorting)
            // or if the progress bar is still visible from a previous state.
            updateUIAfterFetchingAllNoteDetails(new ArrayList<>(sharedNotesList), totalNotesInIndex);
            return;
        }

        final AtomicInteger pendingFetches = new AtomicInteger(noteIdsToFetch.size());
        DatabaseReference individualNoteRefRoot = database.getReference("notes");
        final String currentUserIdLocal = currentUser.getUid();

        // Show progress only if it's not already visible and we are indeed fetching
        if (progressBarMain.getVisibility() == View.GONE) {
            progressBarMain.setVisibility(View.VISIBLE);
            textViewNoSharedNotes.setVisibility(View.GONE);
            recyclerViewSharedNotes.setVisibility(View.GONE); // Hide while fetching new batch
        }

        final List<SharedNoteAdapter.NoteWrapper> newlyFetchedWrappers = new ArrayList<>();

        for (String noteId : noteIdsToFetch) {
            if (noteId == null || noteId.trim().isEmpty()){
                Log.w(TAG, "Skipping null or empty noteId in fetchAllNoteDetails.");
                if(pendingFetches.decrementAndGet() == 0) {
                    synchronized (sharedNotesList) {
                        sharedNotesList.addAll(newlyFetchedWrappers);
                    }
                    updateUIAfterFetchingAllNoteDetails(new ArrayList<>(sharedNotesList), totalNotesInIndex);
                }
                continue;
            }
            individualNoteRefRoot.child(noteId).addListenerForSingleValueEvent(new ValueEventListener() {
                @Override
                public void onDataChange(@NonNull DataSnapshot noteSnapshot) {
                    Note note = noteSnapshot.getValue(Note.class);
                    String currentFetchedNoteId = noteSnapshot.getKey();

                    if (note != null && currentFetchedNoteId != null) {
                        note.setNoteId(currentFetchedNoteId);
                        String otherParticipantUid = null;
                        if (note.getParticipants() != null) {
                            for (Map.Entry<String, Boolean> entry : note.getParticipants().entrySet()) {
                                if (Boolean.TRUE.equals(entry.getValue()) && entry.getKey() != null && !entry.getKey().equals(currentUserIdLocal)) {
                                    otherParticipantUid = entry.getKey();
                                    break;
                                }
                            }
                        }
                        fetchOtherParticipantNameAndPrepareWrapper(note, currentFetchedNoteId, otherParticipantUid, newlyFetchedWrappers, pendingFetches, totalNotesInIndex);
                    } else {
                        Log.w(TAG, "Note data is null or key missing for noteId: " + currentFetchedNoteId + ". Removing from processed.");
                        processedNoteIds.remove(currentFetchedNoteId);
                        if (pendingFetches.decrementAndGet() == 0) {
                            synchronized (sharedNotesList) {
                                sharedNotesList.addAll(newlyFetchedWrappers);
                            }
                            updateUIAfterFetchingAllNoteDetails(new ArrayList<>(sharedNotesList), totalNotesInIndex);
                        }
                    }
                }

                @Override
                public void onCancelled(@NonNull DatabaseError databaseError) {
                    Log.e(TAG, "Failed to fetch details for noteId: " + noteId, databaseError.toException());
                    processedNoteIds.remove(noteId);
                    if (pendingFetches.decrementAndGet() == 0) {
                        synchronized (sharedNotesList) {
                            sharedNotesList.addAll(newlyFetchedWrappers);
                        }
                        updateUIAfterFetchingAllNoteDetails(new ArrayList<>(sharedNotesList), totalNotesInIndex);
                    }
                }
            });
        }
    }

    private void fetchOtherParticipantNameAndPrepareWrapper(Note note, String noteId, @Nullable String otherParticipantUid,
                                                            final List<SharedNoteAdapter.NoteWrapper> newlyFetchedWrappersList,
                                                            final AtomicInteger pendingFetches,
                                                            final int totalNotesInIndex) {
        if (otherParticipantUid == null) {
            String displayName;
            if (note.getParticipants() != null && note.getParticipants().size() == 1 && note.getParticipants().containsKey(currentUser.getUid())) {
                displayName = "Self Note";
            } else if (note.getParticipants() == null || note.getParticipants().isEmpty()){
                displayName = "Note (No participants)";
            } else {
                boolean onlyCurrentUser = true;
                if (note.getParticipants() != null) {
                    for (String participantId : note.getParticipants().keySet()) {
                        if (participantId !=null && !participantId.equals(currentUser.getUid())) { // Added null check for participantId
                            onlyCurrentUser = false;
                            break;
                        }
                    }
                }
                displayName = onlyCurrentUser ? "Self Note" : "Group Note";
            }

            String primaryDisplay = (note.getTitle() != null && !note.getTitle().isEmpty() && !note.getTitle().equals("Untitled Note"))
                    ? note.getTitle()
                    : (note.getContent() != null && !note.getContent().isEmpty()
                    ? note.getContent().substring(0, Math.min(30, note.getContent().length())) + (note.getContent().length() > 30 ? "..." : "")
                    : "Note");

            SharedNoteAdapter.NoteWrapper wrapper = new SharedNoteAdapter.NoteWrapper(note, noteId, primaryDisplay, displayName);
            synchronized (newlyFetchedWrappersList) { newlyFetchedWrappersList.add(wrapper); }

            if (pendingFetches.decrementAndGet() == 0) {
                synchronized (sharedNotesList) {
                    sharedNotesList.addAll(newlyFetchedWrappersList);
                }
                updateUIAfterFetchingAllNoteDetails(new ArrayList<>(sharedNotesList), totalNotesInIndex);
            }
            return;
        }

        DatabaseReference userRef = database.getReference("users").child(otherParticipantUid);
        userRef.addListenerForSingleValueEvent(new ValueEventListener() {
            @Override
            public void onDataChange(@NonNull DataSnapshot snapshot) {
                String otherName = "A Friend";
                if (snapshot.exists()) {
                    User user = snapshot.getValue(User.class);
                    if (user != null && user.getDisplayName() != null && !user.getDisplayName().isEmpty()) {
                        otherName = user.getDisplayName();
                    } else if (user != null && user.getEmail() != null && !user.getEmail().isEmpty()) {
                        otherName = user.getEmail();
                    }
                }
                String primaryDisplay = (note.getTitle() != null && !note.getTitle().isEmpty() && !note.getTitle().equals("Untitled Note"))
                        ? note.getTitle()
                        : (note.getContent() != null && !note.getContent().isEmpty()
                        ? note.getContent().substring(0, Math.min(30, note.getContent().length())) + (note.getContent().length() > 30 ? "..." : "")
                        : "Note");

                SharedNoteAdapter.NoteWrapper wrapper = new SharedNoteAdapter.NoteWrapper(note, noteId, primaryDisplay, otherName);
                synchronized (newlyFetchedWrappersList) { newlyFetchedWrappersList.add(wrapper); }

                if (pendingFetches.decrementAndGet() == 0) {
                    synchronized (sharedNotesList) {
                        sharedNotesList.addAll(newlyFetchedWrappersList);
                    }
                    updateUIAfterFetchingAllNoteDetails(new ArrayList<>(sharedNotesList), totalNotesInIndex);
                }
            }

            @Override
            public void onCancelled(@NonNull DatabaseError error) {
                Log.w(TAG, "Could not fetch participant name for UID: " + otherParticipantUid, error.toException());
                String primaryDisplay = (note.getTitle() != null && !note.getTitle().isEmpty() && !note.getTitle().equals("Untitled Note"))
                        ? note.getTitle()
                        : (note.getContent() != null && !note.getContent().isEmpty()
                        ? note.getContent().substring(0, Math.min(30, note.getContent().length())) + (note.getContent().length() > 30 ? "..." : "")
                        : "Note");
                SharedNoteAdapter.NoteWrapper wrapper = new SharedNoteAdapter.NoteWrapper(note, noteId, primaryDisplay, "A Friend (details unavailable)");
                synchronized (newlyFetchedWrappersList) { newlyFetchedWrappersList.add(wrapper); }

                if (pendingFetches.decrementAndGet() == 0) {
                    synchronized (sharedNotesList) {
                        sharedNotesList.addAll(newlyFetchedWrappersList);
                    }
                    updateUIAfterFetchingAllNoteDetails(new ArrayList<>(sharedNotesList), totalNotesInIndex);
                }
            }
        });
    }

    private void updateUIAfterFetchingAllNoteDetails(List<SharedNoteAdapter.NoteWrapper> currentNotesList, int totalNotesInIndexConsidered) {
        // Sort the provided list (which should be the main sharedNotesList passed as a new ArrayList copy)
        Collections.sort(currentNotesList, (o1, o2) -> {
            if (o1 == null || o1.note == null || o1.note.getTimestamp() == 0L) return 1;
            if (o2 == null || o2.note == null || o2.note.getTimestamp() == 0L) return -1;
            return Long.compare(o2.note.getTimestamp(), o1.note.getTimestamp());
        });

        // Update the adapter with the sorted list
        sharedNoteAdapter.updateNotes(currentNotesList);

        Log.i(TAG, "updateUIAfterFetchingAllNoteDetails: Displaying " + currentNotesList.size() + " notes. Total notes in index considered: " + totalNotesInIndexConsidered);

        progressBarMain.setVisibility(View.GONE);
        if (currentNotesList.isEmpty()) {
            textViewNoSharedNotes.setText("No notes yet. Create one!");
            textViewNoSharedNotes.setVisibility(View.VISIBLE);
            recyclerViewSharedNotes.setVisibility(View.GONE);
        } else {
            textViewNoSharedNotes.setVisibility(View.GONE);
            recyclerViewSharedNotes.setVisibility(View.VISIBLE);
        }
    }


    private void detachUserNotesListener() {
        if (userNotesRef != null && userNotesListener != null) {
            Log.d(TAG, "Detaching user_notes listener.");
            userNotesRef.removeEventListener(userNotesListener);
            userNotesListener = null;
        }
    }


    @Override
    public boolean onCreateOptionsMenu(Menu menu) {
        MenuInflater inflater = getMenuInflater();
        inflater.inflate(R.menu.main_menu, menu);
        return true;
    }

    @Override
    public boolean onOptionsItemSelected(@NonNull MenuItem item) {
        int itemId = item.getItemId();
        if (itemId == R.id.action_sign_out) {
            signOut();
            return true;
        } else if (itemId == R.id.action_refresh_notes) {
            Log.d(TAG, "Refresh notes action selected.");
            if (currentUser != null) {
                processedNoteIds.clear();
                sharedNotesList.clear();
                sharedNoteAdapter.updateNotes(new ArrayList<>(sharedNotesList));
                progressBarMain.setVisibility(View.VISIBLE);
                textViewNoSharedNotes.setVisibility(View.GONE);
                recyclerViewSharedNotes.setVisibility(View.GONE);
                detachUserNotesListener();
                attachUserNotesListener();
            }
            return true;
        }
        return super.onOptionsItemSelected(item);
    }

    private void signOut() {
        Log.d(TAG, "signOut called.");
        //  ADDED: Stop the service when signing out
        stopWidgetService();

        mAuth.signOut();
        if (mGoogleSignInClient != null) {
            mGoogleSignInClient.signOut().addOnCompleteListener(this, task -> {
                Log.d(TAG, "Google Sign-Out complete.");
                navigateToLogin();
            });
        } else {
            navigateToLogin();
        }
    }

    private void navigateToLogin(){
        Toast.makeText(MainActivity.this, "Signed out", Toast.LENGTH_SHORT).show();
        Intent intent = new Intent(MainActivity.this, LoginActivity.class);
        intent.addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP | Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK);
        startActivity(intent);
        finishAffinity();
    }

    @Override
    public void onNoteClick(SharedNoteAdapter.NoteWrapper noteWrapper) {
        if (noteWrapper != null && noteWrapper.noteId != null) {
            Log.d(TAG, "Note clicked: ID = " + noteWrapper.noteId + ", Display = " + noteWrapper.displayTitle + ", With = " + noteWrapper.otherParticipantName);
            Intent intent = new Intent(this, NoteActivity.class);
            intent.putExtra(NoteActivity.EXTRA_NOTE_ID, noteWrapper.noteId);
            startActivity(intent);
        } else {
            Log.e(TAG, "onNoteClick: noteWrapper or noteId is null!");
            Toast.makeText(this, "Error opening note.", Toast.LENGTH_SHORT).show();
        }
    }

    @Override
    public void onNoteLongClick(SharedNoteAdapter.NoteWrapper noteWrapper, View view) {
        if (noteWrapper == null || noteWrapper.noteId == null || currentUser == null) {
            Log.e(TAG, "onNoteLongClick: Invalid note data or user for deletion.");
            return;
        }
        Log.d(TAG, "Long clicked note: ID = " + noteWrapper.noteId + ", Title: " + noteWrapper.displayTitle);

        new AlertDialog.Builder(this)
                .setTitle("Delete Note")
                .setMessage("Are you sure you want to delete the note: \"" + noteWrapper.displayTitle + "\"? This action cannot be undone.")
                .setPositiveButton("Delete", (dialog, which) -> {
                    deleteNoteFromFirebase(noteWrapper);
                })
                .setNegativeButton("Cancel", null)
                .setIcon(android.R.drawable.ic_dialog_alert)
                .show();
    }

    private void deleteNoteFromFirebase(SharedNoteAdapter.NoteWrapper noteWrapperToDelete) {
        if (noteWrapperToDelete == null || noteWrapperToDelete.noteId == null || currentUser == null) {
            Log.e(TAG, "deleteNoteFromFirebase: Cannot delete, invalid data.");
            Toast.makeText(this, "Error: Could not delete note.", Toast.LENGTH_SHORT).show();
            return;
        }

        final String noteIdToDelete = noteWrapperToDelete.noteId;
        Log.d(TAG, "Attempting to delete note: " + noteIdToDelete);
        progressBarMain.setVisibility(View.VISIBLE);

        DatabaseReference mainNoteRef = database.getReference("notes").child(noteIdToDelete);
        mainNoteRef.removeValue().addOnCompleteListener(task -> {
            if (task.isSuccessful()) {
                Log.i(TAG, "Successfully deleted note from /notes/" + noteIdToDelete);
                DatabaseReference userNoteIndexRef = database.getReference("user_notes")
                        .child(currentUser.getUid()).child(noteIdToDelete);
                userNoteIndexRef.removeValue().addOnCompleteListener(indexTask -> {
                    if (indexTask.isSuccessful()) {
                        Log.i(TAG, "Successfully removed note ID " + noteIdToDelete + " from user_notes index for user " + currentUser.getUid());
                        processedNoteIds.remove(noteIdToDelete);
                        sharedNoteAdapter.removeNoteById(noteIdToDelete);
                        updateUIAfterFetchingAllNoteDetails(new ArrayList<>(sharedNotesList), sharedNotesList.size() );

                        if (noteWrapperToDelete.note != null && noteWrapperToDelete.note.getParticipants() != null) {
                            for (String participantId : noteWrapperToDelete.note.getParticipants().keySet()) {
                                if (participantId != null && !participantId.equals(currentUser.getUid())) { // Added null check
                                    Log.d(TAG, "Needs to remove note " + noteIdToDelete + " from user_notes index of participant: " + participantId);
                                    database.getReference("user_notes").child(participantId).child(noteIdToDelete).removeValue();
                                }
                            }
                        }
                        Toast.makeText(MainActivity.this, "Note deleted.", Toast.LENGTH_SHORT).show();

                    } else {
                        Log.e(TAG, "Failed to remove note ID " + noteIdToDelete + " from user_notes index.", indexTask.getException());
                        Toast.makeText(MainActivity.this, "Note deleted, but failed to update your list. Please refresh.", Toast.LENGTH_LONG).show();
                        processedNoteIds.remove(noteIdToDelete);
                        sharedNoteAdapter.removeNoteById(noteIdToDelete);
                        updateUIAfterFetchingAllNoteDetails(new ArrayList<>(sharedNotesList), sharedNotesList.size());
                    }
                });
                sendBroadcastToUpdateWidgetsConfiguredForNote(noteIdToDelete);
            } else {
                Log.e(TAG, "Failed to delete note from /notes/" + noteIdToDelete, task.getException());
                Toast.makeText(MainActivity.this, "Failed to delete note. " + (task.getException() != null ? task.getException().getMessage() : ""), Toast.LENGTH_SHORT).show();
                progressBarMain.setVisibility(View.GONE);
            }
        });
    }

    private void sendBroadcastToUpdateWidgetsConfiguredForNote(String deletedNoteId) {
        AppWidgetManager widgetManager = AppWidgetManager.getInstance(this);
        ComponentName thisWidgetProvider = new ComponentName(this, NoteWidgetProvider.class);
        int[] allWidgetIds = widgetManager.getAppWidgetIds(thisWidgetProvider);

        if (allWidgetIds == null || allWidgetIds.length == 0) {
            Log.d(TAG, "sendBroadcastToUpdateWidgets: No widgets to update for deleted note.");
            return;
        }

        ArrayList<Integer> relevantWidgetIdsList = new ArrayList<>();
        SharedPreferences widgetPrefs = getSharedPreferences(NoteWidgetConfigureActivity.PREFS_NAME, 0);

        for (int appWidgetId : allWidgetIds) {
            String configuredNoteId = widgetPrefs.getString(NoteWidgetConfigureActivity.PREF_KEY_NOTE_ID_PREFIX + appWidgetId, null);
            if (deletedNoteId.equals(configuredNoteId)) {
                relevantWidgetIdsList.add(appWidgetId);
                NoteWidgetConfigureActivity.deleteWidgetPrefs(this, appWidgetId);
            }
        }

        if (!relevantWidgetIdsList.isEmpty()) {
            Intent intent = new Intent(this, NoteWidgetProvider.class);
            intent.setAction(AppWidgetManager.ACTION_APPWIDGET_UPDATE);
            int[] idsToUpdate = new int[relevantWidgetIdsList.size()];
            for (int i = 0; i < relevantWidgetIdsList.size(); i++) {
                idsToUpdate[i] = relevantWidgetIdsList.get(i);
            }
            intent.putExtra(AppWidgetManager.EXTRA_APPWIDGET_IDS, idsToUpdate);
            sendBroadcast(intent);
            Log.i(TAG, "Sent ACTION_APPWIDGET_UPDATE broadcast for deleted note to widgets: " + relevantWidgetIdsList.toString());
        } else {
            Log.d(TAG, "No widgets found configured for the deleted noteId: " + deletedNoteId);
        }
    }


