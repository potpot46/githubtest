    //  ADDED: Method to setup the sync switch
    private void setupSyncSwitch() {
        // Ensure switchBackgroundSync is not null before using it
        if (switchBackgroundSync == null) {
            Log.e(TAG, "switchBackgroundSync is null. Check layout ID.");
            return;
        }
        boolean syncEnabled = appPreferences.getBoolean(PREF_WIDGET_SYNC_ENABLED, true); // Default to true
        switchBackgroundSync.setChecked(syncEnabled);
        Log.d(TAG, "Initial Sync Switch state: " + syncEnabled);

        // If sync is enabled by default and widgets exist, ensure service is started
        // This checkAndStartWidgetService might be called again in onResume, which is fine.
        if (syncEnabled) {
            checkAndStartWidgetService();
        }

        switchBackgroundSync.setOnCheckedChangeListener((buttonView, isChecked) -> {
            appPreferences.edit().putBoolean(PREF_WIDGET_SYNC_ENABLED, isChecked).apply();
            Log.d(TAG, "Sync Switch toggled. New state: " + isChecked);
            if (isChecked) {
                Toast.makeText(MainActivity.this, "Widget auto-sync enabled.", Toast.LENGTH_SHORT).show();
                checkAndStartWidgetService(); // Attempt to start if widgets exist
            } else {
                Toast.makeText(MainActivity.this, "Widget auto-sync disabled.", Toast.LENGTH_SHORT).show();
                stopWidgetService();
            }
        });
    }

    private void requestNotificationPermission() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            if (ContextCompat.checkSelfPermission(this, Manifest.permission.POST_NOTIFICATIONS) !=
                    PackageManager.PERMISSION_GRANTED) {
                Log.d(TAG, "Requesting POST_NOTIFICATIONS permission.");
                ActivityCompat.requestPermissions(this,
                        new String[]{Manifest.permission.POST_NOTIFICATIONS},
                        NOTIFICATION_PERMISSION_REQUEST_CODE);
            } else {
                Log.d(TAG, "POST_NOTIFICATIONS permission already granted.");
                // If permission already granted, ensure service is started if widgets exist AND sync is enabled
                if (appPreferences.getBoolean(PREF_WIDGET_SYNC_ENABLED, true)) {
                    checkAndStartWidgetService();
                }
            }
        } else {
            // For pre-Tiramisu, permission is not needed
            if (appPreferences.getBoolean(PREF_WIDGET_SYNC_ENABLED, true)) {
                checkAndStartWidgetService();
            }
        }
    }

    @Override
    public void onRequestPermissionsResult(int requestCode, @NonNull String[] permissions, @NonNull int[] grantResults) {
        super.onRequestPermissionsResult(requestCode, permissions, grantResults);
        if (requestCode == NOTIFICATION_PERMISSION_REQUEST_CODE) {
            if (grantResults.length > 0 && grantResults[0] == PackageManager.PERMISSION_GRANTED) {
                Log.d(TAG, "POST_NOTIFICATIONS permission granted by user.");
                if (appPreferences.getBoolean(PREF_WIDGET_SYNC_ENABLED, true)) {
                    checkAndStartWidgetService();
                }
            } else {
                Log.w(TAG, "POST_NOTIFICATIONS permission denied by user.");
                Toast.makeText(this, "Notification permission denied. Widget auto-sync may not work as expected.", Toast.LENGTH_LONG).show();
                // If permission is denied, and switch was on, consider turning the switch off
                if (switchBackgroundSync != null && switchBackgroundSync.isChecked()) {
                    switchBackgroundSync.setChecked(false); // Update UI
                    // The listener on switch will handle saving pref and stopping service
                }
            }
        }
    }

    // Helper to check if widgets exist and start service, RESPECTING USER PREFERENCE
    private void checkAndStartWidgetService() {
        if (currentUser == null) return; // Don't do anything if user isn't signed in

        //  MODIFIED: Only start if the preference is ON
        if (!appPreferences.getBoolean(PREF_WIDGET_SYNC_ENABLED, true)) {
            Log.d(TAG, "checkAndStartWidgetService: Sync is disabled by user preference. Not starting service.");
            // Ensure service is stopped if it was somehow running
            stopWidgetService();
            return;
        }

        AppWidgetManager appWidgetManager = AppWidgetManager.getInstance(this);
        ComponentName thisWidgetProvider = new ComponentName(this, NoteWidgetProvider.class);
        int[] allWidgetIds = appWidgetManager.getAppWidgetIds(thisWidgetProvider);

        if (allWidgetIds != null && allWidgetIds.length > 0) {
            Log.d(TAG, "Widgets exist and sync enabled. Ensuring WidgetUpdateService is running.");
            Intent serviceIntent = new Intent(this, WidgetUpdateService.class);
            // This action tells the service to verify its listeners for all active widgets
            serviceIntent.setAction(WidgetUpdateService.ACTION_REFRESH_ALL_LISTENERS);
            try {
                ContextCompat.startForegroundService(this, serviceIntent);
            } catch (Exception e) {
                Log.e(TAG, "Error trying to start WidgetUpdateService from MainActivity", e);
                // If service fails to start, reflect this in the switch and preference
                if (switchBackgroundSync != null) {
                    switchBackgroundSync.setChecked(false);
                }
                appPreferences.edit().putBoolean(PREF_WIDGET_SYNC_ENABLED, false).apply();
                Toast.makeText(this, "Failed to start background sync service.", Toast.LENGTH_LONG).show();
            }
        } else {
            Log.d(TAG, "No widgets found. Service will not be started from MainActivity (even if sync enabled).");
            // If no widgets, we should also ensure the service is stopped
            stopWidgetService();
        }
    }

    //  ADDED: Method to explicitly stop the service
    private void stopWidgetService() {
        Log.d(TAG, "stopWidgetService: Attempting to stop WidgetUpdateService.");
        Intent serviceIntent = new Intent(this, WidgetUpdateService.class);
        stopService(serviceIntent);
    }


    private void createNewNote() {
        if (currentUser == null) {
            Toast.makeText(this, "You must be logged in to create a note.", Toast.LENGTH_SHORT).show();
            return;
        }
        Log.d(TAG, "createNewNote called by user: " + currentUser.getUid());

        DatabaseReference notesRef = database.getReference("notes");
        String newNoteId = notesRef.push().getKey();

        if (newNoteId == null) {
            Toast.makeText(this, "Failed to create new note ID.", Toast.LENGTH_SHORT).show();
            Log.e(TAG, "Failed to generate newNoteId from Firebase push().");
            return;
        }

        Note newNote = new Note();
        newNote.setNoteId(newNoteId);
        newNote.setTitle("New Note");
        newNote.setContent("");
        newNote.setOwnerUid(currentUser.getUid());
        newNote.setOwnerName(currentUser.getDisplayName());
        newNote.setLastEditedByUid(currentUser.getUid());
        newNote.setTimestamp(System.currentTimeMillis());

        Map<String, Boolean> participants = new HashMap<>();
        participants.put(currentUser.getUid(), true);
        newNote.setParticipants(participants);

        notesRef.child(newNoteId).setValue(newNote).addOnCompleteListener(task -> {
            if (task.isSuccessful()) {
                Log.i(TAG, "New note created successfully with ID: " + newNoteId);
                database.getReference("user_notes").child(currentUser.getUid()).child(newNoteId).setValue(true)
                        .addOnCompleteListener(indexTask -> {
                            if (indexTask.isSuccessful()) {
                                Log.i(TAG, "New note ID added to user_notes index for user: " + currentUser.getUid());
                                Intent intent = new Intent(MainActivity.this, NoteActivity.class);
                                intent.putExtra(NoteActivity.EXTRA_NOTE_ID, newNoteId);
                                startActivity(intent);
                            } else {
                                Log.e(TAG, "Failed to add new note ID to user_notes index.", indexTask.getException());
                                Toast.makeText(MainActivity.this, "Note created, but failed to index. Please refresh.", Toast.LENGTH_LONG).show();
                            }
                        });
            } else {
                Log.e(TAG, "Failed to create new note.", task.getException());
                Toast.makeText(MainActivity.this, "Failed to create note. " + (task.getException() != null ? task.getException().getMessage() : ""), Toast.LENGTH_SHORT).show();
            }
        });
    }


    @Override
    protected void onResume() {
        super.onResume();
        Log.d(TAG, "onResume called");
        if (currentUser != null) {
            // Update switch state from preferences every time activity resumes
            if (switchBackgroundSync != null) { // Ensure switch is initialized
                switchBackgroundSync.setChecked(appPreferences.getBoolean(PREF_WIDGET_SYNC_ENABLED, true));
            } else {
                Log.e(TAG, "onResume: switchBackgroundSync is null! Did findViewById fail or was called too late?");
            }


            processedNoteIds.clear();
            sharedNotesList.clear();
            progressBarMain.setVisibility(View.VISIBLE);
            textViewNoSharedNotes.setVisibility(View.GONE);
            recyclerViewSharedNotes.setVisibility(View.GONE);

            attachUserNotesListener();

            // Check and start/stop service based on preference
            if (appPreferences.getBoolean(PREF_WIDGET_SYNC_ENABLED, true)) {
                checkAndStartWidgetService();
            } else {
                stopWidgetService(); // Ensure it's stopped if preference is off
            }
        } else if (!isFinishing()){
            Log.w(TAG, "onResume: User became null, finishing activity.");
            Toast.makeText(this, "User session expired. Please log in again.", Toast.LENGTH_LONG).show();
            signOut();
        }
    }

