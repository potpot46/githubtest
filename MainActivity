    //  ADDED: Helper to check if widgets are present and stop service if not.
    //  This could be called in onDestroy or if user turns off sync.
    private void checkAndStopServiceIfNoWidgets() {
        AppWidgetManager appWidgetManager = AppWidgetManager.getInstance(this);
        ComponentName thisWidgetProvider = new ComponentName(this, NoteWidgetProvider.class);
        int[] allWidgetIds = appWidgetManager.getAppWidgetIds(thisWidgetProvider);
        if (allWidgetIds == null || allWidgetIds.length == 0) {
            Log.d(TAG, "No widgets active, stopping service from checkAndStopServiceIfNoWidgets.");
            stopWidgetService();
        }
    }
