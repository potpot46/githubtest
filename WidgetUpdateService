import androidx.annotation.Nullable;
import androidx.core.app.NotificationCompat;
import androidx.core.content.ContextCompat;
import androidx.preference.PreferenceManager; //  Import for PreferenceManager

import com.example.notetify.R;
import com.example.notetify.activities.MainActivity; // For PREF_WIDGET_SYNC_ENABLED and launching app
import com.example.notetify.activities.NoteActivity; // For EXTRA_NOTE_ID
import com.example.notetify.activities.NoteWidgetConfigureActivity; // For SharedPreferences constants
import com.example.notetify.models.Note;
