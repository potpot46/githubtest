import java.util.ArrayList; // Import for ArrayList
import java.util.HashMap;
import java.util.HashSet;   //  ADDED: Import for HashSet
import java.util.Map;
import java.util.Set;       //  ADDED: Import for Set

public class WidgetUpdateService extends Service {
    public static final String ACTION_TRIGGER_WIDGET_UPDATE_FROM_SERVICE = "com.example.notetify.action.TRIGGER_WIDGET_UPDATE_FROM_SERVICE";
    private static final String TAG = "WidgetUpdateService";
    private static final int NOTIFICATION_ID = 12345;
    private static final String CHANNEL_ID = "WidgetUpdateServiceChannel";

    public static final String ACTION_START_LISTENING = "com.example.notetify.action.START_LISTENING_FOR_WIDGET";
    public static final String ACTION_STOP_LISTENING = "com.example.notetify.action.STOP_LISTENING_FOR_WIDGET";
    public static final String ACTION_REFRESH_ALL_LISTENERS = "com.example.notetify.action.REFRESH_ALL_LISTENERS";

    private final Map<Integer, ValueEventListener> activeListeners = new HashMap<>();
    private final Map<Integer, DatabaseReference> activeRefs = new HashMap<>();
    private FirebaseDatabase database;

    // Timer related - can be removed if pure Firebase listeners are sufficient
    private final Handler handler = new Handler(Looper.getMainLooper());
    private Runnable widgetUpdateRunnable;
    private static final long UPDATE_INTERVAL_MILLIS = 30 * 1000;


    @Override
    public void onCreate() {
        super.onCreate();
        Log.d(TAG, "SERVICE_LIFECYCLE: onCreate CALLED");
        database = FirebaseDatabase.getInstance();
        createNotificationChannel();

        // Runnable for periodic updates (optional, if Firebase listeners aren't enough or for fallback)
        widgetUpdateRunnable = new Runnable() {
            @Override
            public void run() {
                Log.d(TAG, "SERVICE_TIMER: Runnable executing - time to check/update widgets.");
                Context appContext = getApplicationContext();
                if (appContext == null) {
                    Log.e(TAG, "SERVICE_TIMER: ApplicationContext is null, cannot send broadcast.");
                    handler.postDelayed(this, UPDATE_INTERVAL_MILLIS);
                    return;
                }

                // Instead of broadcasting to provider, the service now updates widgets directly
                // when its Firebase listeners fire. This timer can be a fallback
                // or a way to ensure listeners are re-established if they somehow drop.
                // For now, let's make it trigger a refresh of listeners.
                Log.d(TAG, "SERVICE_TIMER: Triggering ACTION_REFRESH_ALL_LISTENERS for self.");
                Intent selfIntent = new Intent(appContext, WidgetUpdateService.class);
                selfIntent.setAction(ACTION_REFRESH_ALL_LISTENERS);
                try {
                    ContextCompat.startForegroundService(appContext, selfIntent); // Ensure service stays alive
                } catch (Exception e) {
                    Log.e(TAG, "SERVICE_TIMER: Error restarting self with REFRESH_ALL_LISTENERS", e);
                }

                handler.postDelayed(this, UPDATE_INTERVAL_MILLIS);
            }
        };

        // Start Foreground Service immediately in onCreate if possible
        // This is often required for services started by BroadcastReceivers
        setupForegroundService();
    }

    private void setupForegroundService() {
        Intent notificationIntent = new Intent(this, MainActivity.class);
        int pendingIntentFlags = PendingIntent.FLAG_UPDATE_CURRENT;
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
            pendingIntentFlags |= PendingIntent.FLAG_IMMUTABLE;
        }
        PendingIntent pendingIntent = PendingIntent.getActivity(this, 0, notificationIntent, pendingIntentFlags);

        Notification notification = new NotificationCompat.Builder(this, CHANNEL_ID)
                .setContentTitle("NoteTify Sync Active")
                .setContentText("Listening for real-time note updates.")
                .setSmallIcon(R.mipmap.ic_launcher) // Ensure this is valid
                .setContentIntent(pendingIntent)
                .setOngoing(true)
                .setPriority(NotificationCompat.PRIORITY_LOW)
                .build();
        try {
            startForeground(NOTIFICATION_ID, notification);
            Log.d(TAG, "SERVICE_LIFECYCLE: startForeground successful in onCreate.");
        } catch (Exception e) {
            Log.e(TAG, "SERVICE_LIFECYCLE: Error in startForeground during onCreate", e);
            // If it fails here, the service is likely to be killed soon by the system.
            // Consider calling stopSelf() or logging a more critical error.
        }
    }


    @Override
    public int onStartCommand(Intent intent, int flags, int startId) {
        Log.d(TAG, "SERVICE_LIFECYCLE: onStartCommand received with action: " + (intent != null ? intent.getAction() : "null intent"));

        SharedPreferences appPreferences = PreferenceManager.getDefaultSharedPreferences(this);
        if (!appPreferences.getBoolean(MainActivity.PREF_WIDGET_SYNC_ENABLED, true)) {
            Log.i(TAG, "SERVICE_LIFECYCLE: Sync is disabled by user preference. Stopping service.");
            stopSelf();
            return START_NOT_STICKY;
        }

        // Ensure service is in foreground (might be called again if service was stopped and restarted)
        // setupForegroundService(); // Called in onCreate, but calling here ensures it if onCreate was skipped (e.g. START_STICKY restart)

        if (intent != null && intent.getAction() != null) {
            int appWidgetId = intent.getIntExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, AppWidgetManager.INVALID_APPWIDGET_ID);
            String noteId = intent.getStringExtra(NoteActivity.EXTRA_NOTE_ID);

            switch (intent.getAction()) {
                case ACTION_START_LISTENING:
                    if (appWidgetId != AppWidgetManager.INVALID_APPWIDGET_ID && noteId != null) {
                        startListeningForNote(appWidgetId, noteId);
                    }
                    break;
                case ACTION_STOP_LISTENING:
                    if (appWidgetId != AppWidgetManager.INVALID_APPWIDGET_ID) {
                        stopListeningForNote(appWidgetId, false); // false: not part of a full refresh loop
                    }
                    break;
                case ACTION_REFRESH_ALL_LISTENERS:
                    refreshListenersForAllWidgets();
                    break;
            }
        } else if ((flags & START_FLAG_RETRY) == 0 && intent == null) { // Initial start or system restart (intent might be null for START_STICKY)
            Log.d(TAG, "Service (re)started by system or initial call without specific action, refreshing listeners.");
            refreshListenersForAllWidgets();
        }

        // Start the 30-second timer if it's not already running
        // This ensures that even if Firebase listeners somehow miss an update,
        // the widget periodically checks for new data via a full refresh.
        handler.removeCallbacks(widgetUpdateRunnable); // Remove existing before posting new
        handler.post(widgetUpdateRunnable);
        Log.d(TAG, "SERVICE_LIFECYCLE: Widget update runnable (re)posted.");

        return START_STICKY;
    }

    private void refreshListenersForAllWidgets() {
        Log.d(TAG, "Refreshing listeners for all widgets.");

        Map<Integer, String> notesToListen = new HashMap<>();
        AppWidgetManager appWidgetManager = AppWidgetManager.getInstance(this);
        ComponentName thisWidgetProvider = new ComponentName(this, NoteWidgetProvider.class);
        int[] allWidgetIds = appWidgetManager.getAppWidgetIds(thisWidgetProvider);

        if (allWidgetIds != null) {
            Log.d(TAG, "Found " + allWidgetIds.length + " widget(s) to check for configuration.");
            for (int appWidgetId : allWidgetIds) {
                String noteId = NoteWidgetConfigureActivity.loadFirebaseNoteIdPref(this, appWidgetId);
                if (noteId != null && !noteId.isEmpty()) {
                    notesToListen.put(appWidgetId, noteId);
                } else {
                    Log.d(TAG, "WidgetId " + appWidgetId + " is not configured with a noteId.");
                }
            }
        } else {
            Log.d(TAG, "No widget IDs returned by AppWidgetManager.");
        }

        // Stop listening for notes that are no longer configured or whose widget was removed
        Set<Integer> currentWidgetIdsWithListeners = new HashSet<>(activeListeners.keySet()); // Create a copy
        for (Integer activeWidgetId : currentWidgetIdsWithListeners) {
            if (!notesToListen.containsKey(activeWidgetId) ||
                    !notesToListen.get(activeWidgetId).equals(getNoteIdForWidget(activeWidgetId))) {
                stopListeningForNote(activeWidgetId, true); // true: called during refresh
            }
        }

        // Start listening for new or changed notes
        for (Map.Entry<Integer, String> entry : notesToListen.entrySet()) {
            startListeningForNote(entry.getKey(), entry.getValue());
        }

        if (activeListeners.isEmpty() && (allWidgetIds == null || allWidgetIds.length == 0)) {
            Log.i(TAG, "No active widgets or listeners after refresh. Stopping service.");
            stopSelf();
        } else {
            Log.i(TAG, "Listeners refreshed. Active listeners count: " + activeListeners.size());
        }
    }


    private void startListeningForNote(int appWidgetId, String noteId) {
        if (noteId == null || noteId.trim().isEmpty()) {
            Log.w(TAG, "Cannot start listening: noteId is null or empty for widgetId " + appWidgetId);
            return;
        }

        // Check if already listening to this exact note for this widget
        if (activeListeners.containsKey(appWidgetId) && noteId.equals(getNoteIdForWidget(appWidgetId))) {
            Log.d(TAG, "Already listening for widgetId: " + appWidgetId + " on noteId: " + noteId + ". No change needed.");
            return;
        }
        // If listening to a different note for this widget, stop the old one first
        if (activeListeners.containsKey(appWidgetId)) {
            Log.d(TAG, "WidgetId " + appWidgetId + " changing listened note from " + getNoteIdForWidget(appWidgetId) + " to " + noteId);
            stopListeningForNote(appWidgetId, true); // true: part of a re-configuration
        }


        Log.i(TAG, "Starting to listen for noteId: " + noteId + " for widgetId: " + appWidgetId);
        DatabaseReference noteRef = database.getReference("notes").child(noteId);
        ValueEventListener listener = new ValueEventListener() {
            @Override
            public void onDataChange(@NonNull DataSnapshot dataSnapshot) {
                Log.d(TAG, "Firebase data change for widgetId: " + appWidgetId + ", noteId: " + noteId + ", Exists: " + dataSnapshot.exists());
                AppWidgetManager appWidgetManager = AppWidgetManager.getInstance(WidgetUpdateService.this);
                Note note = dataSnapshot.getValue(Note.class);

                if (note != null) {
                    String title = (note.getTitle() != null && !note.getTitle().isEmpty()) ? note.getTitle() : "Untitled";
                    String content = (note.getContent() != null && !note.getContent().isEmpty()) ? note.getContent() : "(Empty)";
                    String displayTitle = title;
                    FirebaseUser currentUser = FirebaseAuth.getInstance().getCurrentUser();

                    if (currentUser != null) {
                        if (note.getSharedWithName() != null && !note.getSharedWithName().isEmpty()) {
                            displayTitle = "Note shared with: " + note.getSharedWithName();
                        } else if (note.getSharedWithUserId() != null && !note.getSharedWithUserId().isEmpty()) {
                            if (note.getOwnerUid() != null && currentUser.getUid().equals(note.getOwnerUid()) && !currentUser.getUid().equals(note.getSharedWithUserId())) {
                                displayTitle = "Shared: " + note.getSharedWithUserId().substring(0, Math.min(6, note.getSharedWithUserId().length())) + "...";
                            } else if (currentUser.getUid().equals(note.getSharedWithUserId()) && note.getOwnerUid() != null && !currentUser.getUid().equals(note.getOwnerUid())) {
                                displayTitle = "Note from: " + (note.getOwnerName() != null && !note.getOwnerName().isEmpty() ? note.getOwnerName() : note.getOwnerUid().substring(0, Math.min(6, note.getOwnerUid().length())) + "...");
                            }
                        }
                    }
                    Log.i(TAG, "Updating widget " + appWidgetId + " from Firebase listener. Title: \"" + displayTitle.substring(0, Math.min(20,displayTitle.length())) + "...\"");
                    NoteWidgetProvider.updateAppWidgetInstance(WidgetUpdateService.this, appWidgetManager, appWidgetId, noteId, displayTitle, content);
                } else {
                    Log.w(TAG, "Note data became null for widgetId: " + appWidgetId + ", noteId: " + noteId + ". Updating widget to reflect 'Note Deleted'.");
                    NoteWidgetProvider.updateAppWidgetInstance(WidgetUpdateService.this, appWidgetManager, appWidgetId, noteId, "Note Deleted", "(Content unavailable)");
                    // Note might have been deleted, stop listening for it.
                    stopListeningForNote(appWidgetId, false); // false: not part of refresh
                }
            }

            @Override
            public void onCancelled(@NonNull DatabaseError databaseError) {
                Log.e(TAG, "Firebase listener cancelled for widgetId: " + appWidgetId + ", noteId: " + noteId, databaseError.toException());
                // Optionally update widget to show error state
            }
        };

        noteRef.addValueEventListener(listener);
        activeListeners.put(appWidgetId, listener);
        activeRefs.put(appWidgetId, noteRef);
    }

    private String getNoteIdForWidget(int appWidgetId) {
        DatabaseReference ref = activeRefs.get(appWidgetId);
        return ref != null ? ref.getKey() : null;
    }


    private void stopListeningForNote(int appWidgetId, boolean calledDuringRefresh) {
        if (activeListeners.containsKey(appWidgetId)) {
            DatabaseReference ref = activeRefs.get(appWidgetId); // Define ref here
            ValueEventListener listener = activeListeners.get(appWidgetId);
            if (ref != null && listener != null) {
                ref.removeEventListener(listener);
                // Now ref is in scope for the log
                Log.d(TAG, "Stopped listening for widgetId: " + appWidgetId + " on noteId: " + ref.getKey());
            } else {
                Log.d(TAG, "Stopped listening for widgetId: " + appWidgetId + " (ref or listener was already null)");
            }
        }
        activeListeners.remove(appWidgetId);
        activeRefs.remove(appWidgetId);

        if (!calledDuringRefresh && activeListeners.isEmpty()) {
            Log.i(TAG, "No active listeners left after specific stop. Stopping service.");
            stopSelf();
        }
    }


    @Override
    public void onDestroy() {
        Log.i(TAG, "SERVICE_LIFECYCLE: onDestroy CALLED. Cleaning up all listeners.");
        if (handler != null && widgetUpdateRunnable != null) {
            handler.removeCallbacks(widgetUpdateRunnable);
            Log.d(TAG, "SERVICE_LIFECYCLE: Widget update runnable (timer) callbacks removed.");
        }
        // Iterate over a copy of keys to avoid ConcurrentModificationException if stopListeningForNote modifies the map
        for (Integer appWidgetId : new ArrayList<>(activeRefs.keySet())) {
            stopListeningForNote(appWidgetId, true); // true: part of full cleanup
        }
        activeListeners.clear();
        activeRefs.clear();
        Log.i(TAG, "SERVICE_LIFECYCLE: All listeners and refs cleared.");
        super.onDestroy();
    }

    @Nullable
    @Override
    public IBinder onBind(Intent intent) {
        return null;
    }

    private void createNotificationChannel() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            NotificationChannel serviceChannel = new NotificationChannel(
                    CHANNEL_ID,
                    "NoteTify Real-time Sync",
                    NotificationManager.IMPORTANCE_LOW);
            serviceChannel.setDescription("Keeps widgets updated with real-time note changes.");
            NotificationManager manager = getSystemService(NotificationManager.class);
            if (manager != null) {
                manager.createNotificationChannel(serviceChannel);
                Log.d(TAG, "SERVICE_LIFECYCLE: Notification channel created.");
            } else {
                Log.e(TAG, "SERVICE_LIFECYCLE: NotificationManager is null for channel creation.");
            }
        }
    }
}
