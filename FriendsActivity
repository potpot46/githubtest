    @Override
    public void onStartNoteClick(User friend) {
        FirebaseUser currentUser = mAuth.getCurrentUser();
        if (currentUser == null || friend == null || friend.uid == null) { // Added null check for friend
            Toast.makeText(this, "Error: User information missing.", Toast.LENGTH_SHORT).show();
            Log.e(TAG, "onStartNoteClick: currentUser or friend or friend.uid is null.");
            return;
        }
        final String currentUserUid = currentUser.getUid();
        final String friendUid = friend.uid;

        // Ensure UIDs are not the same (shouldn't happen if friend list is correct)
        if (currentUserUid.equals(friendUid)) {
            Toast.makeText(this, "Cannot start a note with yourself from the friends list.", Toast.LENGTH_SHORT).show();
            Log.w(TAG, "onStartNoteClick: Attempted to start note with self.");
            return;
        }

        final String noteId = (currentUserUid.compareTo(friendUid) < 0) ?
                currentUserUid + "-" + friendUid :
                friendUid + "-" + currentUserUid;

        Log.d(TAG, "Generated noteId: " + noteId + " for users " + currentUserUid + " and " + friendUid);

        final DatabaseReference noteNodeRef = database.getReference("notes").child(noteId);
        final DatabaseReference rootRef = database.getReference(); // For multi-path update

        // Check if the note already exists to avoid overwriting content if just participants need adding.
        noteNodeRef.addListenerForSingleValueEvent(new ValueEventListener() {
            @Override
            public void onDataChange(@NonNull DataSnapshot noteSnapshot) {
                Map<String, Object> updates = new HashMap<>();
                boolean existingNote = noteSnapshot.exists();

                Log.d(TAG, "Note " + noteId + (existingNote ? " exists." : " does not exist."));

                // Path for current user's note index
                String userNotePath1 = "/user_notes/" + currentUserUid + "/" + noteId;
                updates.put(userNotePath1, true);

                // Path for friend's note index
                String userNotePath2 = "/user_notes/" + friendUid + "/" + noteId;
                updates.put(userNotePath2, true); // Always try to ensure friend also has the index

                // Ensure participants are set in the main note object
                String participantsPath1 = "/notes/" + noteId + "/participants/" + currentUserUid;
                if (!existingNote || !Boolean.TRUE.equals(noteSnapshot.child("participants").child(currentUserUid).getValue(Boolean.class))) {
                    Log.i(TAG, (existingNote ? "UPDATING" : "CREATING") + " user " + currentUserUid + " as participant for note " + noteId);
                    updates.put(participantsPath1, true);
                }

                String participantsPath2 = "/notes/" + noteId + "/participants/" + friendUid;
                if (!existingNote || !Boolean.TRUE.equals(noteSnapshot.child("participants").child(friendUid).getValue(Boolean.class))) {
                    Log.i(TAG, (existingNote ? "UPDATING" : "CREATING") + " friend " + friendUid + " as participant for note " + noteId);
                    updates.put(participantsPath2, true);
                }

                // If the note doesn't exist at all, create its basic structure
                if (!existingNote) {
                    Log.i(TAG, "Note " + noteId + " does not exist. CREATING FULL NOTE OBJECT.");
                    updates.put("/notes/" + noteId + "/content", "");
                    updates.put("/notes/" + noteId + "/lastEditedByUid", currentUserUid);
                    updates.put("/notes/" + noteId + "/timestamp", System.currentTimeMillis()); // Use client time for creation
                    // Note: For timestamp on edit, NoteActivity will use System.currentTimeMillis().
                    // If you want server time for creation consistently, you'd use ServerValue.TIMESTAMP
                    // updates.put("/notes/" + noteId + "/timestamp", ServerValue.TIMESTAMP);
                    // And your Note model's timestamp field should be Long (which it is).
                }

                if (!updates.isEmpty()) {
                    Log.d(TAG, "Performing Firebase update. FULL UPDATES MAP: " + updates.toString());
                    rootRef.updateChildren(updates, new DatabaseReference.CompletionListener() {
                        @Override
                        public void onComplete(@Nullable DatabaseError databaseError, @NonNull DatabaseReference databaseReference) {
                            if (databaseError == null) {
                                Log.i(TAG, "Successfully updated note/user_notes for " + noteId);
                                launchNoteActivity(noteId);
                            } else {
                                Log.e(TAG, "Failed to update note/user_notes for " + noteId, databaseError.toException());
                                Toast.makeText(FriendsActivity.this, "Error preparing note: " + databaseError.getMessage(), Toast.LENGTH_LONG).show();
                            }
                        }
                    });
                } else {
                    Log.d(TAG, "No updates needed for Firebase for note " + noteId + ". Launching NoteActivity.");
                    launchNoteActivity(noteId); // Note and indexes already exist and are correct
                }
            }

            @Override
            public void onCancelled(@NonNull DatabaseError databaseError) {
                Log.e(TAG, "Failed to check note existence for " + noteId, databaseError.toException());
                Toast.makeText(FriendsActivity.this, "Error accessing note data.", Toast.LENGTH_SHORT).show();
            }
        });
    }
    // ------------- MODIFICATION END: onStartNoteClick -------------


    private void launchNoteActivity(String noteId) {
        Intent intent = new Intent(FriendsActivity.this, NoteActivity.class);
        intent.putExtra(NoteActivity.EXTRA_NOTE_ID, noteId);
        startActivity(intent);
    }

    @Override
    public void onUnfriendClick(User friendToUnfriend) {
        if (friendToUnfriend == null || friendToUnfriend.getUid() == null) {
            Toast.makeText(this, "Cannot unfriend this user.", Toast.LENGTH_SHORT).show();
            return;
        }

        FirebaseUser currentUser = mAuth.getCurrentUser();
        if (currentUser == null) {
            Toast.makeText(this, "You are not logged in.", Toast.LENGTH_SHORT).show();
            return;
        }

        String currentUserId = currentUser.getUid();
        String friendId = friendToUnfriend.getUid();
        String friendName = friendToUnfriend.getDisplayName() != null && !friendToUnfriend.getDisplayName().isEmpty() ?
                friendToUnfriend.getDisplayName() : friendToUnfriend.getEmail();

        new AlertDialog.Builder(this)
                .setTitle("Unfriend User")
                .setMessage("Are you sure you want to unfriend " + friendName + "?")
                .setPositiveButton("Unfriend", (dialog, which) -> {
                    performUnfriend(currentUserId, friendId, friendName);
                })
                .setNegativeButton("Cancel", null)
                .show();
    }

    // ------------- MODIFICATION START: performUnfriend (One-sided removal) -------------
    private void performUnfriend(String currentUserId, String friendId, String friendNameForToast) {
        progressBarFriends.setVisibility(View.VISIBLE);

        DatabaseReference currentUserFriendEntryRef = database.getReference("users")
                .child(currentUserId).child("friends").child(friendId);

        Map<String, Object> unfriendUpdates = new HashMap<>();
        // Only remove friend from current user's list on the client-side
        unfriendUpdates.put("/users/" + currentUserId + "/friends/" + friendId, null);

        // The line below is commented out because the client does not have permission
        // to write to the other user's friend list directly.
        // This reciprocal action should be handled by a Cloud Function or other server-side logic for full bidirectionality.
        // unfriendUpdates.put("/users/" + friendId + "/friends/" + currentUserId, null);

        Log.d(TAG, "Attempting to unfriend (one-sided from client): Removing " + friendId + " from " + currentUserId + "'s friend list. Updates: " + unfriendUpdates.toString());

        database.getReference().updateChildren(unfriendUpdates, (@Nullable DatabaseError databaseError, @NonNull DatabaseReference databaseReference) -> {
            progressBarFriends.setVisibility(View.GONE);
            if (databaseError == null) {
                Toast.makeText(FriendsActivity.this, "You are no longer friends with " + friendNameForToast + ". They will also need to remove you for the change to be mutual.", Toast.LENGTH_LONG).show();
                Log.d(TAG, "Successfully removed " + friendId + " from " + currentUserId + "'s friend list.");
                // The ValueEventListener on /users/{currentUserId}/friends should automatically refresh the list.
            } else {
                // This should ideally not happen if the rule for users/$uid/.write is auth.uid == $uid
                Toast.makeText(FriendsActivity.this, "Failed to unfriend. " + databaseError.getMessage(), Toast.LENGTH_LONG).show();
                Log.e(TAG, "Failed to remove " + friendId + " from " + currentUserId + "'s friend list.", databaseError.toException());
            }
        });
    }
    // ------------- MODIFICATION END: performUnfriend -------------


