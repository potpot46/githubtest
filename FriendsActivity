            startActivity(intent);
        });

        buttonViewFriendRequests.setOnClickListener(v -> {
            Intent intent = new Intent(FriendsActivity.this, FriendRequestsActivity.class);
            startActivity(intent);
        });

        FirebaseUser currentUser = mAuth.getCurrentUser();
        if (currentUser != null) {
            currentUserFriendsRef = database.getReference("users")
                    .child(currentUser.getUid()).child("friends");
        } else {
            Toast.makeText(this, "User not logged in.", Toast.LENGTH_SHORT).show();
