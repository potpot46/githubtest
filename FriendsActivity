        mAuth = FirebaseAuth.getInstance();

        recyclerViewFriends = findViewById(R.id.recyclerViewFriends);
        progressBarFriends = findViewById(R.id.progressBarFriends);
        buttonGoToAddFriend = findViewById(R.id.buttonGoToAddFriend);
        buttonViewFriendRequests = findViewById(R.id.buttonViewFriendRequests);
