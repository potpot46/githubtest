        }
    }

    @Override
    protected void onResume() {
        super.onResume();
        FirebaseUser currentUser = mAuth.getCurrentUser();
        if (currentUser != null) {
            if (currentUserFriendsRef == null) {
                currentUserFriendsRef = database.getReference("users")
                        .child(currentUser.getUid()).child("friends");
            }
            attachFriendsListener();
        } else if (!isFinishing()) {
            Toast.makeText(this, "User not logged in.", Toast.LENGTH_SHORT).show();
        }
    }

    @Override
    protected void onPause() {
        super.onPause();
        detachFriendsListener();
    }

    private void attachFriendsListener() {
        if (currentUserFriendsRef == null) return;

        progressBarFriends.setVisibility(View.VISIBLE);
        textViewNoFriends.setVisibility(View.GONE);

        if (friendsListener == null) {
            friendsListener = new ValueEventListener() {
                @Override
                public void onDataChange(@NonNull DataSnapshot dataSnapshot) {
                    if (!dataSnapshot.exists() || dataSnapshot.getChildrenCount() == 0) {
                        progressBarFriends.setVisibility(View.GONE);
                        friendsDisplayList.clear();
                        friendsAdapter.updateData(new ArrayList<>(friendsDisplayList)); // Pass new list
                        textViewNoFriends.setText("You have no friends yet. Add some!");
                        textViewNoFriends.setVisibility(View.VISIBLE);
                        Log.d(TAG, "No friends found in Firebase or dataSnapshot empty.");
                        return;
                    }

                    List<String> friendUids = new ArrayList<>();
                    for (DataSnapshot friendSnapshot : dataSnapshot.getChildren()) {
                        if (Boolean.TRUE.equals(friendSnapshot.getValue(Boolean.class)) && friendSnapshot.getKey() != null) {
                            friendUids.add(friendSnapshot.getKey());
                        }
                    }

                    Log.d(TAG, "Friend UIDs fetched: " + friendUids.size());
                    if (friendUids.isEmpty()) {
                        progressBarFriends.setVisibility(View.GONE);
                        friendsDisplayList.clear();
                        friendsAdapter.updateData(new ArrayList<>(friendsDisplayList)); // Pass new list
                        textViewNoFriends.setText("Your friend list is empty.");
                        textViewNoFriends.setVisibility(View.VISIBLE);
                        return;
                    }
                    fetchFriendDetails(new ArrayList<>(friendUids));
                }

                @Override
                public void onCancelled(@NonNull DatabaseError databaseError) {
                    Log.e(TAG, "loadFriends:onCancelled", databaseError.toException());
                    progressBarFriends.setVisibility(View.GONE);
                    textViewNoFriends.setText("Failed to load friends list.");
                    textViewNoFriends.setVisibility(View.VISIBLE);
                }
            };
            currentUserFriendsRef.addValueEventListener(friendsListener);
        } else {
            if (friendsDisplayList.isEmpty() && progressBarFriends.getVisibility() == View.GONE) {
                progressBarFriends.setVisibility(View.VISIBLE);
                textViewNoFriends.setVisibility(View.GONE);
            }
        }
    }

    private void detachFriendsListener() {
        if (currentUserFriendsRef != null && friendsListener != null) {
            currentUserFriendsRef.removeEventListener(friendsListener);
            friendsListener = null;
        }
    }


    private void fetchFriendDetails(List<String> friendUidsFromListener) {
        final List<String> friendUids = new ArrayList<>(friendUidsFromListener);
        Log.i(TAG, "Starting fetchFriendDetails for " + friendUids.size() + " UIDs: " + friendUids);

        // final List<User> successfullyFetchedFriendsBatch = new ArrayList<>(); // Not directly used like this anymore
        DatabaseReference usersRef = database.getReference("users");
        AtomicInteger fetchesRemaining = new AtomicInteger(friendUids.size());

        if (friendUids.isEmpty()) {
            Log.d(TAG, "fetchFriendDetails called with empty UID list.");
            updateAdapterAndUI(new ArrayList<>(), 0); // Pass empty list
            return;
        }

        progressBarFriends.setVisibility(View.VISIBLE);
        textViewNoFriends.setVisibility(View.GONE);
        List<User> currentBatchFetchedFriends = new ArrayList<>();

        for (String friendUid : friendUids) {
            if (friendUid == null) {
                Log.w(TAG, "Null friendUid encountered in list.");
                if (fetchesRemaining.decrementAndGet() == 0) {
                    updateAdapterAndUI(currentBatchFetchedFriends, friendUids.size());
                }
                continue;
            }
            Log.d(TAG, "Attempting to fetch details for UID: " + friendUid);
            usersRef.child(friendUid).addListenerForSingleValueEvent(new ValueEventListener() {
                @Override
                public void onDataChange(@NonNull DataSnapshot userDetailSnapshot) {
                    Log.d(TAG, "onDataChange for user detail UID: " + friendUid + ", Exists: " + userDetailSnapshot.exists());
                    if (userDetailSnapshot.exists()) {
                        User friend = userDetailSnapshot.getValue(User.class);
                        if (friend != null && friend.getUid() != null) {
                            Log.i(TAG, "SUCCESS: Fetched details for: " + friend.getUid() + " - " + (friend.getDisplayName() != null ? friend.getDisplayName() : friend.getEmail()));
                            currentBatchFetchedFriends.add(friend);
                        } else {
                            Log.w(TAG, "WARNING: Fetched User object is null or its UID is null for friend UID: " + friendUid + ". Snapshot data: " + userDetailSnapshot.getValue());
                        }
                    } else {
                        Log.w(TAG, "WARNING: No user data found in /users node for friend UID: " + friendUid);
                    }

                    if (fetchesRemaining.decrementAndGet() == 0) {
                        Log.i(TAG, "All user detail fetches complete. Total successfully fetched this batch: " + currentBatchFetchedFriends.size());
                        updateAdapterAndUI(currentBatchFetchedFriends, friendUids.size());
                    }
                }

                @Override
                public void onCancelled(@NonNull DatabaseError databaseError) {
                    Log.e(TAG, "loadFriendDetails:onCancelled for UID: " + friendUid, databaseError.toException());
                    if (fetchesRemaining.decrementAndGet() == 0) {
                        updateAdapterAndUI(currentBatchFetchedFriends, friendUids.size());
                    }
                }
            });
        }
    }

    private void updateAdapterAndUI(List<User> newlyFetchedFriendsForThisBatch, int totalExpectedUidsBasedOnFriendList) {
        progressBarFriends.setVisibility(View.GONE);
        this.friendsDisplayList.clear();
        this.friendsDisplayList.addAll(newlyFetchedFriendsForThisBatch);
        friendsAdapter.updateData(new ArrayList<>(this.friendsDisplayList)); // Important to pass a new list for DiffUtil

        Log.i(TAG, "updateAdapterAndUI: Displaying " + this.friendsDisplayList.size() + " friends. Originally expected " + totalExpectedUidsBasedOnFriendList + " UIDs from friends list.");

        if (this.friendsDisplayList.isEmpty()) {
            textViewNoFriends.setText(totalExpectedUidsBasedOnFriendList > 0 ? "Could not load friend details." : "You have no friends yet. Add some!");
            textViewNoFriends.setVisibility(View.VISIBLE);
        } else {
            textViewNoFriends.setVisibility(View.GONE);
        }
    }


