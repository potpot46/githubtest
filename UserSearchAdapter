package com.example.notetify.adapters;

import android.view.LayoutInflater;
import android.view.View;
import android.view.ViewGroup;
import android.widget.Button;
import android.widget.TextView;
import androidx.annotation.NonNull;
import androidx.recyclerview.widget.RecyclerView;
import com.example.notetify.R;
import com.example.notetify.models.User;
import java.util.List;
import java.util.Map;

public class UserSearchAdapter extends RecyclerView.Adapter<UserSearchAdapter.UserViewHolder> {

    private List<User> users;
    private final OnAddFriendClickListener listener;
    private Map<String, String> friendRequestStatuses; // UID -> "pending", "friends", or null

    public interface OnAddFriendClickListener {
        void onSendRequestClick(User user);
    }

    public UserSearchAdapter(List<User> users, Map<String, String> friendRequestStatuses, OnAddFriendClickListener listener) {
        this.users = users;
        this.friendRequestStatuses = friendRequestStatuses;
        this.listener = listener;
    }

    @NonNull
    @Override
    public UserViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
        View view = LayoutInflater.from(parent.getContext())
                .inflate(R.layout.item_search_result, parent, false);
        return new UserViewHolder(view);
    }

    @Override
    public void onBindViewHolder(@NonNull UserViewHolder holder, int position) {
        User user = users.get(position);
        holder.bind(user, friendRequestStatuses.get(user.uid), listener);
    }

    @Override
    public int getItemCount() {
        return users.size();
    }

    public void updateUsers(List<User> newUsers, Map<String, String> newStatuses) {
        this.users = newUsers;
        this.friendRequestStatuses = newStatuses;
        notifyDataSetChanged();
    }

    static class UserViewHolder extends RecyclerView.ViewHolder {
        TextView userNameTextView;
        Button sendRequestButton;

        UserViewHolder(View itemView) {
            super(itemView);
            userNameTextView = itemView.findViewById(R.id.textViewUserName);
            sendRequestButton = itemView.findViewById(R.id.buttonSendRequest);
        }

        void bind(final User user, String status, final OnAddFriendClickListener listener) {
            userNameTextView.setText(user.displayName != null ? user.displayName : user.email);

            if ("friends".equals(status)) {
                sendRequestButton.setText("Friends");
                sendRequestButton.setEnabled(false);
            } else if ("pending".equals(status)) {
                sendRequestButton.setText("Request Sent");
                sendRequestButton.setEnabled(false);
            } else {
                sendRequestButton.setText("Add Friend");
                sendRequestButton.setEnabled(true);
                sendRequestButton.setOnClickListener(v -> listener.onSendRequestClick(user));
            }
        }
    }
}
