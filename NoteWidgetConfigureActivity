    private static final String TAG = "NoteWidgetConfigure";

    //  MODIFIED: Standardized SharedPreferences constants
    public static final String PREFS_NAME = "com.example.notetify.NoteWidgetPrefs"; // Used by NoteActivity too
    public static final String PREF_KEY_NOTE_ID_PREFIX = "widget_note_id_";
    public static final String PREF_KEY_TITLE_PREFIX = "widget_title_";
    public static final String PREF_KEY_CONTENT_PREFIX = "widget_content_";

