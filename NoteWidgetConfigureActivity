    int mAppWidgetId = AppWidgetManager.INVALID_APPWIDGET_ID;
    Spinner spinnerNotes;
    Button buttonConfigureWidget;
    ProgressBar progressBarLoadingNotes;
    TextView textViewNoNotesForWidget;

    List<Note> availableFirebaseNotes;
    List<String> spinnerNoteDisplayItems; // Stores strings for the spinner

    FirebaseAuth mAuth;
    FirebaseUser currentUser;
    FirebaseDatabase database;

    @Override
    protected void onCreate(@Nullable Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setResult(RESULT_CANCELED); // Default result if user backs out
        setContentView(R.layout.activity_note_widget_configure);
        Log.d(TAG, "onCreate for widgetId: " + mAppWidgetId);

        spinnerNotes = findViewById(R.id.spinner_notes);
        buttonConfigureWidget = findViewById(R.id.button_configure_widget);
        progressBarLoadingNotes = findViewById(R.id.progressBarLoadingWidgetNotes);
        textViewNoNotesForWidget = findViewById(R.id.textViewNoNotesForWidget);

        mAuth = FirebaseAuth.getInstance();
        currentUser = mAuth.getCurrentUser();
        database = FirebaseDatabase.getInstance();

        Intent intent = getIntent();
        Bundle extras = intent.getExtras();
        if (extras != null) {
            mAppWidgetId = extras.getInt(
                    AppWidgetManager.EXTRA_APPWIDGET_ID, AppWidgetManager.INVALID_APPWIDGET_ID);
        }

        // If an invalid ID or no user, finish immediately
        if (mAppWidgetId == AppWidgetManager.INVALID_APPWIDGET_ID) {
            Log.e(TAG, "Invalid AppWidgetId. Finishing configuration.");
            finish();
            return;
        }
        if (currentUser == null) {
            Log.e(TAG, "User not logged in. Finishing configuration.");
            Toast.makeText(this, "Please log in to configure widget.", Toast.LENGTH_LONG).show();
            finish();
            return;
        }


        availableFirebaseNotes = new ArrayList<>();
        spinnerNoteDisplayItems = new ArrayList<>();

        loadFirebaseNotesForSpinner();

        buttonConfigureWidget.setOnClickListener(v -> configureWidget());
    }

    private void loadFirebaseNotesForSpinner() {
        Log.d(TAG, "loadFirebaseNotesForSpinner called for widgetId: " + mAppWidgetId);
        progressBarLoadingNotes.setVisibility(View.VISIBLE);
        textViewNoNotesForWidget.setVisibility(View.GONE);
        spinnerNotes.setVisibility(View.INVISIBLE); // Hide spinner while loading
        buttonConfigureWidget.setEnabled(false);

        String currentUserId = currentUser.getUid();
        DatabaseReference userNotesRef = database.getReference("user_notes").child(currentUserId);
        Log.d(TAG, "Loading notes from /user_notes/" + currentUserId);

        userNotesRef.addListenerForSingleValueEvent(new ValueEventListener() {
            @Override
            public void onDataChange(@NonNull DataSnapshot userNotesSnapshot) {
                availableFirebaseNotes.clear();
                spinnerNoteDisplayItems.clear();

                if (!userNotesSnapshot.exists() || userNotesSnapshot.getChildrenCount() == 0) {
                    Log.d(TAG, "No notes found in /user_notes for user: " + currentUserId);
                    updateSpinnerAndUiState(true, "No notes available for widget.");
                    return;
                }

                List<String> noteIdsToFetchDetailsFor = new ArrayList<>();
                for (DataSnapshot noteIdEntry : userNotesSnapshot.getChildren()) {
                    if (noteIdEntry.getKey() != null && Boolean.TRUE.equals(noteIdEntry.getValue(Boolean.class))) {
                        noteIdsToFetchDetailsFor.add(noteIdEntry.getKey());
                    }
                }

                if (noteIdsToFetchDetailsFor.isEmpty()) {
                    Log.d(TAG, "No valid note IDs extracted from /user_notes.");
                    updateSpinnerAndUiState(true, "No notes available for widget.");
                    return;
                }
                Log.d(TAG, "Found " + noteIdsToFetchDetailsFor.size() + " note IDs. Fetching details...");
                fetchDetailsForTheseNotes(noteIdsToFetchDetailsFor);
            }

            @Override
            public void onCancelled(@NonNull DatabaseError databaseError) {
                Log.e(TAG, "Failed to load /user_notes for widget config.", databaseError.toException());
                handleNoteLoadingError("Error loading notes index.");
            }
        });
    }

    private void fetchDetailsForTheseNotes(List<String> noteIds) {
        final DatabaseReference notesRootRef = database.getReference("notes");
        final int totalToFetch = noteIds.size();
        final AtomicInteger fetchesCompleted = new AtomicInteger(0);
        availableFirebaseNotes.clear(); // Clear before fetching new batch

        if (totalToFetch == 0) { // Should be caught by previous checks, but good safeguard
            updateSpinnerAndUiState(false, "No notes to fetch details for.");
            return;
        }

        for (String noteId : noteIds) {
            if (noteId == null || noteId.trim().isEmpty()) { // Safety check
                Log.w(TAG, "Skipping null or empty noteId during detail fetch.");
                if (fetchesCompleted.incrementAndGet() == totalToFetch) {
                    updateSpinnerAndUiState(false, null); // Pass null to let it decide message based on availableFirebaseNotes
                }
                continue;
            }
            notesRootRef.child(noteId).addListenerForSingleValueEvent(new ValueEventListener() {
                @Override
                public void onDataChange(@NonNull DataSnapshot noteDetailSnapshot) {
                    if (noteDetailSnapshot.exists()) {
                        Note note = noteDetailSnapshot.getValue(Note.class);
                        if (note != null) {
                            note.setNoteId(noteDetailSnapshot.getKey());
                            availableFirebaseNotes.add(note);
                            Log.d(TAG, "Fetched detail for noteId: " + note.getNoteId() + ", Title: " + note.getTitle());
                        } else {
                            Log.w(TAG, "Note object null for noteId: " + noteDetailSnapshot.getKey() + " even though snapshot exists.");
                        }
                    } else {
                        Log.w(TAG, "Note detail snapshot does not exist for noteId: " + noteDetailSnapshot.getKey());
                    }

                    if (fetchesCompleted.incrementAndGet() == totalToFetch) {
                        updateSpinnerAndUiState(false, null);
                    }
                }

                @Override
                public void onCancelled(@NonNull DatabaseError databaseError) {
                    Log.e(TAG, "Failed to fetch detail for noteId: " + noteId, databaseError.toException());
                    // Consider not setting error message here if some notes load successfully
                    if (fetchesCompleted.incrementAndGet() == totalToFetch) {
                        updateSpinnerAndUiState(availableFirebaseNotes.isEmpty(), "Error fetching some note details.");
                    }
                }
            });
        }
    }

    private void handleNoteLoadingError(String errorMessage) {
        progressBarLoadingNotes.setVisibility(View.GONE);
        spinnerNoteDisplayItems.clear();
        spinnerNoteDisplayItems.add(errorMessage); // Add error message to spinner itself
        ArrayAdapter<String> adapter = new ArrayAdapter<>(NoteWidgetConfigureActivity.this,
                android.R.layout.simple_spinner_item, spinnerNoteDisplayItems);
        adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item);
        spinnerNotes.setAdapter(adapter);
        spinnerNotes.setVisibility(View.VISIBLE);
        textViewNoNotesForWidget.setText(errorMessage);
        textViewNoNotesForWidget.setVisibility(View.VISIBLE);
        buttonConfigureWidget.setEnabled(false);
    }

    private void updateSpinnerAndUiState(boolean errorOccurred, @Nullable String customMessageIfEmpty) {
        spinnerNoteDisplayItems.clear();

        if (!availableFirebaseNotes.isEmpty()) {
            Collections.sort(availableFirebaseNotes, (o1, o2) -> { // Sort notes by timestamp
                if (o1 == null || o1.getTimestamp() == 0L) return 1;
                if (o2 == null || o2.getTimestamp() == 0L) return -1;
                return Long.compare(o2.getTimestamp(), o1.getTimestamp()); // Newest first
            });
            for (Note note : availableFirebaseNotes) {
                String title = (note.getTitle() != null && !note.getTitle().isEmpty() && !note.getTitle().equals("Untitled Note"))
                        ? note.getTitle() : "Untitled";
                String contentPreview = (note.getContent() != null && !note.getContent().isEmpty())
                        ? (": " + note.getContent().substring(0, Math.min(20, note.getContent().length())) + (note.getContent().length() > 20 ? "..." : ""))
                        : (title.equals("Untitled") ? ": (Empty Note)" : ""); // Show empty only if title is also default
                spinnerNoteDisplayItems.add(title + contentPreview);
            }
        }

        ArrayAdapter<String> adapter = new ArrayAdapter<>(NoteWidgetConfigureActivity.this,
                android.R.layout.simple_spinner_item, spinnerNoteDisplayItems);
        adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item);
        spinnerNotes.setAdapter(adapter);
        progressBarLoadingNotes.setVisibility(View.GONE);
        buttonConfigureWidget.setEnabled(!availableFirebaseNotes.isEmpty() && !errorOccurred);
        spinnerNotes.setVisibility(View.VISIBLE);

        if (availableFirebaseNotes.isEmpty()) {
            String message = errorOccurred ? (customMessageIfEmpty != null ? customMessageIfEmpty : "Error loading notes.") :
                    (customMessageIfEmpty != null ? customMessageIfEmpty : "No notes found to display.");
            textViewNoNotesForWidget.setText(message);
            textViewNoNotesForWidget.setVisibility(View.VISIBLE);
        } else {
            textViewNoNotesForWidget.setVisibility(View.GONE);
        }
    }

