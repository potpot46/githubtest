    private void configureWidget() {
        if (availableFirebaseNotes.isEmpty() || spinnerNotes.getSelectedItemPosition() < 0 ||
                spinnerNotes.getSelectedItemPosition() >= availableFirebaseNotes.size()) {
            Toast.makeText(this, "Please select a valid note from the list or wait for notes to load.", Toast.LENGTH_LONG).show();
            return;
        }

        Note selectedFirebaseNote = availableFirebaseNotes.get(spinnerNotes.getSelectedItemPosition());
        String firebaseNoteId = selectedFirebaseNote.getNoteId();

        if (firebaseNoteId == null || firebaseNoteId.trim().isEmpty()) {
            Toast.makeText(this, "Selected note has an invalid ID.", Toast.LENGTH_SHORT).show();
            Log.e(TAG, "Selected note for widget " + mAppWidgetId + " has null or empty firebaseNoteId.");
            return;
        }

        // --- RESTORED LOGIC for getting actual title and content ---
        String actualNoteTitle = (selectedFirebaseNote.getTitle() != null && !selectedFirebaseNote.getTitle().isEmpty()) ?
                selectedFirebaseNote.getTitle() : "Untitled Note";
        String actualNoteContent = (selectedFirebaseNote.getContent() != null && !selectedFirebaseNote.getContent().isEmpty()) ?
                selectedFirebaseNote.getContent() : "(Empty Note)";
        // --- END RESTORED LOGIC ---

        // Determine the display title for the widget (could be "Shared with: Name" or actual title)
        String widgetDisplayTitle = actualNoteTitle; // Default to actual title
        if (selectedFirebaseNote.getSharedWithName() != null && !selectedFirebaseNote.getSharedWithName().isEmpty()) {
            widgetDisplayTitle = "Note shared with: " + selectedFirebaseNote.getSharedWithName();
        } else if (selectedFirebaseNote.getSharedWithUserId() != null && !selectedFirebaseNote.getSharedWithUserId().isEmpty() &&
                currentUser != null && !currentUser.getUid().equals(selectedFirebaseNote.getSharedWithUserId())) {
            // If sharedWithUserId is present but name isn't (and it's not self), show a placeholder
            // This part can be enhanced if you fetch the name here, but for now, a generic shared title.
            // Or, if owner is known and current user is not owner but is sharedWithUserId
            if (selectedFirebaseNote.getOwnerUid() != null && !selectedFirebaseNote.getOwnerUid().equals(currentUser.getUid()) && currentUser.getUid().equals(selectedFirebaseNote.getSharedWithUserId())) {
                widgetDisplayTitle = "Note from: " + (selectedFirebaseNote.getOwnerName() != null ? selectedFirebaseNote.getOwnerName() : "a friend"); // Assuming Note has getOwnerName()
            } else if (selectedFirebaseNote.getOwnerUid() != null && currentUser.getUid().equals(selectedFirebaseNote.getOwnerUid())) {
                widgetDisplayTitle = "Shared: " + selectedFirebaseNote.getSharedWithUserId().substring(0, Math.min(6, selectedFirebaseNote.getSharedWithUserId().length())) + "...";
            } else {
                widgetDisplayTitle = "Shared Note";
            }
        }
        // If it's the user's own note and not specifically marked as shared for widget display
        else if (currentUser != null && selectedFirebaseNote.getOwnerUid() != null && selectedFirebaseNote.getOwnerUid().equals(currentUser.getUid())) {
            widgetDisplayTitle = actualNoteTitle; // Just show the actual title
        }


        // Save snippets for SharedPreferences
        String titleSnippetForPrefs = widgetDisplayTitle;
        if (titleSnippetForPrefs.length() > 50) titleSnippetForPrefs = titleSnippetForPrefs.substring(0, 47) + "...";

        String contentSnippetForPrefs = actualNoteContent;
        if (contentSnippetForPrefs.length() > 100) contentSnippetForPrefs = contentSnippetForPrefs.substring(0, 97) + "...";
        if (contentSnippetForPrefs.isEmpty() && actualNoteTitle.equals("Untitled Note") && widgetDisplayTitle.equals("Untitled Note")) {
            contentSnippetForPrefs = "(Empty Note)";
        }


        saveWidgetPrefs(this, mAppWidgetId, firebaseNoteId, titleSnippetForPrefs, contentSnippetForPrefs);

        AppWidgetManager appWidgetManager = AppWidgetManager.getInstance(this);
        // For the *initial* update from configure, pass the determined widgetDisplayTitle and actualNoteContent
        NoteWidgetProvider.updateAppWidgetInstance(this, appWidgetManager, mAppWidgetId, firebaseNoteId, widgetDisplayTitle, actualNoteContent);

        // Tell the service to start listening for this newly configured widget
        Intent serviceIntent = new Intent(this, WidgetUpdateService.class);
        serviceIntent.setAction(WidgetUpdateService.ACTION_START_LISTENING);
        serviceIntent.putExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, mAppWidgetId);
        serviceIntent.putExtra(NoteActivity.EXTRA_NOTE_ID, firebaseNoteId); // Use a consistent key for note ID
        try {
            ContextCompat.startForegroundService(this, serviceIntent);
            Log.d(TAG, "Sent ACTION_START_LISTENING to service for new widgetId: " + mAppWidgetId);
        } catch (Exception e) {
            Log.e(TAG, "Error sending START_LISTENING to service from configureWidget", e);
        }

        Intent resultValue = new Intent();
        resultValue.putExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, mAppWidgetId);
        setResult(RESULT_OK, resultValue);
        Log.d(TAG, "Widget configured for widget ID: " + mAppWidgetId + " with Firebase note ID: " + firebaseNoteId + ", Display Title: " + widgetDisplayTitle);
        finish();
    }

    // SharedPreferences helper methods
    public static void saveWidgetPrefs(Context context, int appWidgetId, String firebaseNoteId, String titleSnippet, String contentSnippet) {
        SharedPreferences.Editor prefs = context.getSharedPreferences(PREFS_NAME, 0).edit();
        prefs.putString(PREF_KEY_NOTE_ID_PREFIX + appWidgetId, firebaseNoteId);
        prefs.putString(PREF_KEY_TITLE_PREFIX + appWidgetId, titleSnippet); // Use new key
        prefs.putString(PREF_KEY_CONTENT_PREFIX + appWidgetId, contentSnippet); // Use new key
        prefs.apply();
        Log.d(TAG, "Saved Prefs for widgetId " + appWidgetId + ": NoteId=" + firebaseNoteId + ", TitleSnippet=\"" + titleSnippet + "\", ContentSnippet=\"" + contentSnippet.substring(0, Math.min(20,contentSnippet.length())) + "...\"");
    }

    public static String loadFirebaseNoteIdPref(Context context, int appWidgetId) {
        SharedPreferences prefs = context.getSharedPreferences(PREFS_NAME, 0);
        String noteId = prefs.getString(PREF_KEY_NOTE_ID_PREFIX + appWidgetId, null);
        return noteId;
    }

    public static String loadFirebaseNoteTitlePref(Context context, int appWidgetId) {
        SharedPreferences prefs = context.getSharedPreferences(PREFS_NAME, 0);
        // Provide a sensible default if the title snippet isn't found
        String title = prefs.getString(PREF_KEY_TITLE_PREFIX + appWidgetId, "NoteTify Note");
        return title;
    }

    public static String loadFirebaseNoteContentSnippetPref(Context context, int appWidgetId) {
        SharedPreferences prefs = context.getSharedPreferences(PREFS_NAME, 0);
        // Provide a sensible default if the content snippet isn't found
        String snippet = prefs.getString(PREF_KEY_CONTENT_PREFIX + appWidgetId, "Content unavailable");
        return snippet;
    }

    public static void deleteWidgetPrefs(Context context, int appWidgetId) {
        SharedPreferences.Editor prefs = context.getSharedPreferences(PREFS_NAME, 0).edit();
        prefs.remove(PREF_KEY_NOTE_ID_PREFIX + appWidgetId);
        prefs.remove(PREF_KEY_TITLE_PREFIX + appWidgetId);
        prefs.remove(PREF_KEY_CONTENT_PREFIX + appWidgetId);
        prefs.apply();
        Log.d(TAG, "Deleted prefs for widgetId " + appWidgetId);
    }
