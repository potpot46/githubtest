    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_note);
        Log.d(TAG, "onCreate: Activity creating.");

        sharedPreferences = PreferenceManager.getDefaultSharedPreferences(this);

        toolbar = findViewById(R.id.toolbarNote); // Initialize toolbar
        setSupportActionBar(toolbar);
        if (getSupportActionBar() != null) {
            getSupportActionBar().setDisplayHomeAsUpEnabled(true);
            // Initial title, will be updated by Firebase listener
            getSupportActionBar().setTitle("Loading Note...");
        }

        editTextNoteTitle = findViewById(R.id.editTextNoteTitle);
        editTextNote = findViewById(R.id.editTextNote);

        database = FirebaseDatabase.getInstance();
        mAuth = FirebaseAuth.getInstance();
        currentUser = mAuth.getCurrentUser();

        if (currentUser == null) {
            Toast.makeText(this, "User not logged in. Cannot open note.", Toast.LENGTH_LONG).show();
            Log.e(TAG, "onCreate: CurrentUser is null. Finishing NoteActivity.");
            finish();
            return;
        }

        noteId = getIntent().getStringExtra(EXTRA_NOTE_ID);
        if (noteId == null || noteId.trim().isEmpty()) {
            Toast.makeText(this, "Error: Note ID is missing.", Toast.LENGTH_LONG).show();
            Log.e(TAG, "onCreate: Note ID is null or empty. Finishing NoteActivity.");
            finish();
            return;
        }

        Log.i(TAG, "onCreate: NoteActivity started for noteId: " + noteId);

        noteReference = database.getReference("notes").child(noteId);

        setupTitleTextWatcher();
        setupContentTextWatcher();
        loadAndApplyPreferences();
    }

    @Override
    protected void onResume() {
        super.onResume();
        Log.d(TAG, "onResume: Attaching note listener for noteId: " + noteId);
        attachNoteListener();
    }

    @Override
    protected void onPause() {
        super.onPause();
        Log.d(TAG, "onPause: Detaching note listener for noteId: " + noteId);
        detachNoteListener();
    }

    @Override
    protected void onDestroy() {
        super.onDestroy();
        Log.d(TAG, "onDestroy: Ensuring note listener is detached for noteId: " + noteId);
        if (editTextNoteTitle != null && titleTextWatcher != null) {
            editTextNoteTitle.removeTextChangedListener(titleTextWatcher);
        }
        detachNoteListener();
    }

    private void loadAndApplyPreferences() {
        Log.d(TAG, "loadAndApplyPreferences called.");
        float fontSize = sharedPreferences.getFloat(PREF_FONT_SIZE, 18f);
        editTextNote.setTextSize(TypedValue.COMPLEX_UNIT_SP, fontSize);

        int fontStyle = sharedPreferences.getInt(PREF_FONT_STYLE, Typeface.NORMAL);
        editTextNote.setTypeface(null, fontStyle);

        TypedValue typedValue = new TypedValue();
        getTheme().resolveAttribute(android.R.attr.colorBackground, typedValue, true);
        int defaultBgColor = typedValue.data;
        int bgColor = sharedPreferences.getInt(PREF_BG_COLOR, defaultBgColor);
        editTextNote.setBackgroundColor(bgColor);

        if (isColorDark(bgColor)) {
            editTextNote.setTextColor(Color.WHITE);
        } else {
            editTextNote.setTextColor(Color.BLACK);
        }

        // Apply light purple background to Toolbar
        toolbar.setBackgroundColor(ContextCompat.getColor(this, R.color.light_blue_50));
        toolbar.setTitleTextColor(ContextCompat.getColor(this, R.color.md_theme_inversePrimary));
        if (toolbar.getNavigationIcon() != null) {
            DrawableCompat.setTint(toolbar.getNavigationIcon(), ContextCompat.getColor(this, R.color.md_theme_errorContainer_mediumContrast));
        }
    }

    private boolean isColorDark(int color) {
        double darkness = 1 - (0.299 * Color.red(color) + 0.587 * Color.green(color) + 0.114 * Color.blue(color)) / 255;
        return darkness >= 0.5;
    }

    private void setupTitleTextWatcher() {
        Log.d(TAG, "setupTitleTextWatcher called.");
        if (editTextNoteTitle == null) return;

        titleTextWatcher = new TextWatcher() {
            @Override
            public void beforeTextChanged(CharSequence s, int start, int count, int after) {}
            @Override
            public void onTextChanged(CharSequence s, int start, int before, int count) {}
            @Override
            public void afterTextChanged(Editable s) {
                if (currentUser == null || noteReference == null) return;
                if (!isUpdatingFromFirebase) {
                    String title = s.toString();
                    Log.i(TAG, "Title changed locally. Saving: \"" + title.substring(0, Math.min(20, title.length())) + "...\"");
                    Map<String, Object> titleUpdate = new HashMap<>();
                    titleUpdate.put("title", title);
                    // Don't overwrite sharedWithName if it's already set by sharing logic
                    // titleUpdate.put("sharedWithName", null); // Or some logic if title edit should clear it
                    titleUpdate.put("lastEditedByUid", currentUser.getUid());
                    titleUpdate.put("timestamp", System.currentTimeMillis());
                    noteReference.updateChildren(titleUpdate)
                            .addOnSuccessListener(aVoid -> {
                                Log.i(TAG, "SAVE SUCCESS: Note title updated in Firebase for noteId: " + noteId);
                                sendWidgetUpdateBroadcast(noteId);
                            })
                            .addOnFailureListener(e -> Log.e(TAG, "SAVE FAILURE: Failed to update note title.", e));
                } else {
                    Log.d(TAG, "afterTextChanged (TITLE): Change was from Firebase. Ignoring.");
                }
            }
        };
        editTextNoteTitle.addTextChangedListener(titleTextWatcher);
    }

    private void setupContentTextWatcher() {
        Log.d(TAG, "setupContentTextWatcher called.");
        if (editTextNote == null) return;
        editTextNote.addTextChangedListener(new TextWatcher() {
            @Override
            public void beforeTextChanged(CharSequence s, int start, int count, int after) {}
            @Override
            public void onTextChanged(CharSequence s, int start, int before, int count) {}
            @Override
            public void afterTextChanged(Editable s) {
                if (currentUser == null) { return; }
                if (noteReference == null) { return; }
                if (!isUpdatingFromFirebase) {
                    String content = s.toString();
                    Log.i(TAG, "Content changed locally. Saving: \"" + content.substring(0, Math.min(20, content.length())) + "...\"");
                    Map<String, Object> noteUpdates = new HashMap<>();
                    noteUpdates.put("content", content);
                    noteUpdates.put("lastEditedByUid", currentUser.getUid());
                    noteUpdates.put("timestamp", System.currentTimeMillis());
                    noteReference.updateChildren(noteUpdates)
                            .addOnSuccessListener(aVoid -> {
                                Log.i(TAG, "SAVE SUCCESS: Note content updated in Firebase for noteId: " + noteId);
                                sendWidgetUpdateBroadcast(noteId);
                            })
                            .addOnFailureListener(e -> {
                                Log.e(TAG, "SAVE FAILURE: Failed to update note content for noteId: " + noteId, e);
                                Toast.makeText(NoteActivity.this, "Save failed. Check connection.", Toast.LENGTH_SHORT).show();
                            });
                } else {
                    Log.d(TAG, "afterTextChanged (CONTENT): Change was from Firebase. Ignoring.");
                }
            }
        });
    }

    private void attachNoteListener() {
        if (noteReference == null) {
            Log.e(TAG, "attachNoteListener: noteReference is null. Cannot attach listener.");
            return;
        }
        if (noteListener == null) {
            Log.i(TAG, "Attaching new ValueEventListener to: " + noteReference.toString());
            noteListener = new ValueEventListener() {
                @Override
                public void onDataChange(@NonNull DataSnapshot dataSnapshot) {
                    Log.d(TAG, "onDataChange: Received data for " + noteId + ". Exists: " + dataSnapshot.exists());
                    if (dataSnapshot.exists()) {
                        Note note = dataSnapshot.getValue(Note.class);
                        if (note != null) {
                            isUpdatingFromFirebase = true;

                            // --- Update Toolbar Title ---
                            updateToolbarTitle(note);
                            // --- End Update Toolbar Title ---

                            String newTitleFromFirebase = note.getTitle() != null ? note.getTitle() : "Untitled Note";
                            Log.d(TAG, "onDataChange: Firebase title field: \"" + newTitleFromFirebase.substring(0, Math.min(20, newTitleFromFirebase.length())) + "...\"");
                            if (editTextNoteTitle.getText() == null || !editTextNoteTitle.getText().toString().equals(newTitleFromFirebase)) {
                                Log.i(TAG, "onDataChange: Updating EditTextTitle.");
                                editTextNoteTitle.setText(newTitleFromFirebase);
                                lastKnownNoteTitle = newTitleFromFirebase;
                            } else {
                                if(editTextNoteTitle.getText() != null) lastKnownNoteTitle = editTextNoteTitle.getText().toString();
                            }

                            String newContent = note.getContent() != null ? note.getContent() : "";
                            Log.d(TAG, "onDataChange: Firebase content: \"" + newContent.substring(0, Math.min(20, newContent.length())) + "...\"");
                            if (editTextNote.getText() == null || !editTextNote.getText().toString().equals(newContent)) {
                                Log.i(TAG, "onDataChange: Updating EditTextContent.");
                                editTextNote.setText(newContent);
                                if (editTextNote.getText() != null) {
                                    editTextNote.setSelection(editTextNote.getText().length());
                                }
                                lastKnownNoteContent = newContent;
                            } else {
                                if(editTextNote.getText() != null) lastKnownNoteContent = editTextNote.getText().toString();
                            }
                            isUpdatingFromFirebase = false;
                        } else {
                            Log.w(TAG, "onDataChange: Note object deserialized as null for " + noteId + ". Snapshot: " + dataSnapshot.getValue());
                            isUpdatingFromFirebase = true;
                            editTextNoteTitle.setText("Untitled Note");
                            editTextNote.setText("");
                            if (getSupportActionBar() != null) getSupportActionBar().setTitle("Note Error");
                            isUpdatingFromFirebase = false;
                            lastKnownNoteTitle = "Untitled Note";
                            lastKnownNoteContent = "";
                        }
                    } else {
                        Log.w(TAG, "onDataChange: Snapshot for " + noteId + " does not exist. Clearing EditTexts.");
                        isUpdatingFromFirebase = true;
                        editTextNoteTitle.setText("Untitled Note");
                        editTextNote.setText("");
                        if (getSupportActionBar() != null) getSupportActionBar().setTitle("Note Not Found");
                        isUpdatingFromFirebase = false;
                        lastKnownNoteTitle = "Untitled Note";
                        lastKnownNoteContent = "";
                    }
                }
                @Override
                public void onCancelled(@NonNull DatabaseError databaseError) {
                    Log.e(TAG, "onCancelled: Firebase note listener cancelled for " + noteId, databaseError.toException());
                    Toast.makeText(NoteActivity.this, "Error loading note.", Toast.LENGTH_SHORT).show();
                    if (getSupportActionBar() != null) getSupportActionBar().setTitle("Error Loading");
                    isUpdatingFromFirebase = false;
                }
            };
            noteReference.addValueEventListener(noteListener);
        } else {
            Log.d(TAG, "attachNoteListener: Listener already attached for " + noteId);
        }
    }

    // --- New method to update toolbar title based on sharing ---
    private void updateToolbarTitle(Note note) {
        if (getSupportActionBar() == null || note == null) {
            return;
        }
        // If sharedWithName is present, prioritize it
        if (note.getSharedWithName() != null && !note.getSharedWithName().isEmpty()) {
            getSupportActionBar().setTitle("Note shared with: " + note.getSharedWithName());
        }
        // Else if sharedWithUserId is present (but name isn't), try to fetch name, or show UID
        else if (note.getSharedWithUserId() != null && !note.getSharedWithUserId().isEmpty()) {
            // If current user is the owner, and it's shared with someone else
            if (currentUser != null && note.getOwnerUid() != null && currentUser.getUid().equals(note.getOwnerUid()) && !currentUser.getUid().equals(note.getSharedWithUserId())) {
                fetchUserNameAndSetTitle(note.getSharedWithUserId(), "Note shared with: %s");
            }
            // If current user is NOT the owner, but is the sharedWithUserId
            else if (currentUser != null && currentUser.getUid().equals(note.getSharedWithUserId()) && note.getOwnerUid() != null) {
                fetchUserNameAndSetTitle(note.getOwnerUid(), "Note from: %s");
            }
            // Fallback if neither of above, or if ownerUid is null
            else {
                getSupportActionBar().setTitle("Shared Note"); // Generic shared title
            }
        }
        // Else if it's owned by the current user and not specifically marked as shared (for widget)
        else if (currentUser != null && note.getOwnerUid() != null && note.getOwnerUid().equals(currentUser.getUid())) {
            getSupportActionBar().setTitle(note.getTitle() != null && !note.getTitle().isEmpty() ? note.getTitle() : "My Note");
        }
        // Default fallback (e.g. a note owned by someone else where currentUser is a general participant)
        else {
            getSupportActionBar().setTitle(note.getTitle() != null && !note.getTitle().isEmpty() ? note.getTitle() : "Note");
        }
    }

    private void fetchUserNameAndSetTitle(String userId, final String titleFormat) {
        if (userId == null || userId.isEmpty()) {
            if (getSupportActionBar() != null) getSupportActionBar().setTitle("Shared Note");
            return;
        }
        DatabaseReference userRef = database.getReference("users").child(userId).child("displayName");
        userRef.addListenerForSingleValueEvent(new ValueEventListener() {
            @Override
            public void onDataChange(@NonNull DataSnapshot dataSnapshot) {
                if (getSupportActionBar() == null) return;
                if (dataSnapshot.exists() && dataSnapshot.getValue(String.class) != null) {
                    String name = dataSnapshot.getValue(String.class);
                    getSupportActionBar().setTitle(String.format(titleFormat, name));
                } else {
                    String shortUid = userId.length() > 6 ? userId.substring(0, 6) + "..." : userId;
                    getSupportActionBar().setTitle(String.format(titleFormat, shortUid)); // Fallback to UID
                }
            }
            @Override
            public void onCancelled(@NonNull DatabaseError databaseError) {
                if (getSupportActionBar() != null) getSupportActionBar().setTitle("Shared Note (Error)");
                Log.e(TAG, "Failed to fetch user name for title", databaseError.toException());
            }
        });
    }
    // --- End new method ---

    private void detachNoteListener() {
        if (noteReference != null && noteListener != null) {
            Log.i(TAG, "Detaching ValueEventListener from: " + noteReference.toString());
            noteReference.removeEventListener(noteListener);
            noteListener = null;
        } else {
            Log.d(TAG, "detachNoteListener: No listener to detach or noteReference is null.");
        }
    }

