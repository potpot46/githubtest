    @Override
    public boolean onOptionsItemSelected(@NonNull MenuItem item) {
        int itemId = item.getItemId();
        if (itemId == android.R.id.home) {
            onBackPressed();
            return true;
        } else if (itemId == R.id.action_save_note) {
            if (currentUser != null && noteReference != null) {
                String currentTitle = (editTextNoteTitle.getText() != null) ? editTextNoteTitle.getText().toString() : "Untitled Note";
                String currentContent = (editTextNote.getText() != null) ? editTextNote.getText().toString() : "";

                Map<String, Object> noteUpdates = new HashMap<>();
                noteUpdates.put("title", currentTitle);
                noteUpdates.put("content", currentContent);
                noteUpdates.put("lastEditedByUid", currentUser.getUid());
                noteUpdates.put("timestamp", System.currentTimeMillis());
                // If current user is owner, and the title isn't "Note shared with...", then clear sharedWithName
                // This logic can be complex, be careful.
                // For simplicity, if user edits title, assume they want it to be the primary title.
                // If they want to re-share, they'd use a share action.
                // noteUpdates.put("sharedWithName", null); // Could clear sharedWithName if title is edited.
                // noteUpdates.put("sharedWithUserId", null);

                noteReference.updateChildren(noteUpdates)
                        .addOnSuccessListener(aVoid -> {
                            Toast.makeText(this, "Note saved!", Toast.LENGTH_SHORT).show();
                            sendWidgetUpdateBroadcast(noteId);
                        })
                        .addOnFailureListener(e -> Toast.makeText(this, "Save failed.", Toast.LENGTH_SHORT).show());
            }
            return true;
        } else if (itemId == R.id.action_share_note) {
            // TODO: Implement a proper sharing dialog that updates sharedWithUserId and sharedWithName
            // For now, this just uses the generic Android share.
            showShareNoteDialog(); // Call the new share dialog
            return true;
        } else if (itemId == R.id.action_clear_note) {
            clearNoteContent();
            return true;
        } else if (itemId == R.id.action_settings_note) {
            showSettingsDialog();
            return true;
        }
        return super.onOptionsItemSelected(item);
    }


    private void showShareNoteDialog() {
        // This is a placeholder. You'll need a more complex dialog to select a user
        // and then update the note's sharedWithUserId and sharedWithName fields.
        // For now, let's just show a toast and perform a generic share.

        AlertDialog.Builder builder = new AlertDialog.Builder(this);
        builder.setTitle("Share Note With...");
        // In a real app, you'd populate this with a list of friends/users
        // For this example, let's assume we have a target user's ID and Name
        // You would get this from user input (e.g., EditText for email/ID, or friend list)

        // --- This part is conceptual and needs your actual user selection logic ---
        final EditText inputUserId = new EditText(this);
        inputUserId.setHint("Enter User ID to share with");
        builder.setView(inputUserId);

        builder.setPositiveButton("Share", (dialog, which) -> {
            String targetUserId = inputUserId.getText().toString().trim();
            if (targetUserId.isEmpty()) {
                Toast.makeText(NoteActivity.this, "User ID cannot be empty", Toast.LENGTH_SHORT).show();
                return;
            }
            if (currentUser != null && currentUser.getUid().equals(targetUserId)){
                Toast.makeText(NoteActivity.this, "Cannot share note with yourself.", Toast.LENGTH_SHORT).show();
                return;
            }

            // Fetch the target user's name
            DatabaseReference targetUserRef = database.getReference("users").child(targetUserId);
            targetUserRef.addListenerForSingleValueEvent(new ValueEventListener() {
                @Override
                public void onDataChange(@NonNull DataSnapshot snapshot) {
                    if (snapshot.exists()) {
                        User targetUser = snapshot.getValue(User.class);
                        String targetUserName = (targetUser != null && targetUser.getDisplayName() != null) ? targetUser.getDisplayName() : "User " + targetUserId.substring(0, Math.min(targetUserId.length(), 4));

                        // Update the note in Firebase
                        Map<String, Object> shareUpdates = new HashMap<>();
                        shareUpdates.put("sharedWithUserId", targetUserId);
                        shareUpdates.put("sharedWithName", targetUserName);
                        shareUpdates.put("participants/" + targetUserId, true); // Add to participants
                        if (currentUser != null) {
                            shareUpdates.put("ownerUid", currentUser.getUid()); // Ensure owner is set
                            shareUpdates.put("participants/" + currentUser.getUid(), true); // Ensure owner is participant
                        }
                        shareUpdates.put("lastEditedByUid", currentUser != null ? currentUser.getUid() : "system_share");
                        shareUpdates.put("timestamp", System.currentTimeMillis());


                        noteReference.updateChildren(shareUpdates)
                                .addOnSuccessListener(aVoid -> {
                                    Toast.makeText(NoteActivity.this, "Note shared with " + targetUserName, Toast.LENGTH_LONG).show();
                                    // The onDataChange listener will update the toolbar title
                                    sendWidgetUpdateBroadcast(noteId);
                                })
                                .addOnFailureListener(e -> Toast.makeText(NoteActivity.this, "Failed to share note.", Toast.LENGTH_SHORT).show());
                    } else {
                        Toast.makeText(NoteActivity.this, "User ID not found.", Toast.LENGTH_SHORT).show();
                    }
                }
                @Override
                public void onCancelled(@NonNull DatabaseError error) {
                    Toast.makeText(NoteActivity.this, "Error fetching user details.", Toast.LENGTH_SHORT).show();
                }
            });
        });
        builder.setNegativeButton("Cancel", (dialog, which) -> dialog.cancel());
        builder.setNeutralButton("Generic Share", (dialog, which) -> {
            // Fallback to simple text share
            shareNoteContent();
        });
        builder.show();
        // --- End conceptual part ---
    }


    private void shareNoteContent() { // This is the generic text share
        String titleToShare = (editTextNoteTitle.getText() != null) ? editTextNoteTitle.getText().toString() : "Note";
        String contentToShare = (editTextNote.getText() != null) ? editTextNote.getText().toString() : "";

        if (contentToShare.isEmpty() && titleToShare.equals("Note")) {
            Toast.makeText(this, "Nothing to share.", Toast.LENGTH_SHORT).show();
            return;
        }
        Intent shareIntent = new Intent(Intent.ACTION_SEND);
        shareIntent.setType("text/plain");
        shareIntent.putExtra(Intent.EXTRA_SUBJECT, titleToShare);
        shareIntent.putExtra(Intent.EXTRA_TEXT, titleToShare + "\n\n" + contentToShare);
        startActivity(Intent.createChooser(shareIntent, "Share Note via"));
    }

    private void clearNoteContent() {
        if (currentUser == null || noteReference == null) {
            Toast.makeText(this, "Cannot clear note.", Toast.LENGTH_SHORT).show();
            return;
        }
        new AlertDialog.Builder(this)
                .setTitle("Clear Note")
                .setMessage("Are you sure you want to clear this note (title and content)? This will also remove sharing information.")
                .setPositiveButton("Clear", (dialog, which) -> {
                    Map<String, Object> updates = new HashMap<>();
                    updates.put("title", "Untitled Note");
                    updates.put("content", "");
                    updates.put("sharedWithUserId", null); // Clear sharing info
                    updates.put("sharedWithName", null);   // Clear sharing info
                    // Keep ownerUid, but reset participants to just the owner
                    Map<String, Boolean> ownerParticipant = new HashMap<>();
                    if (currentUser != null) {
                        updates.put("ownerUid", currentUser.getUid());
                        ownerParticipant.put(currentUser.getUid(), true);
                    }
                    updates.put("participants", ownerParticipant);


                    updates.put("lastEditedByUid", currentUser.getUid());
                    updates.put("timestamp", System.currentTimeMillis());
                    noteReference.updateChildren(updates)
                            .addOnSuccessListener(aVoid -> {
                                Toast.makeText(this, "Note cleared.", Toast.LENGTH_SHORT).show();
                                sendWidgetUpdateBroadcast(noteId);
                            })
                            .addOnFailureListener(e -> Toast.makeText(this, "Failed to clear note.", Toast.LENGTH_SHORT).show());
                })
                .setNegativeButton("Cancel", null)
                .show();
    }

    private void showSettingsDialog() {
        AlertDialog.Builder builder = new AlertDialog.Builder(this);
        LayoutInflater inflater = getLayoutInflater();
        View dialogView = inflater.inflate(R.layout.dialog_settings, null);
        builder.setView(dialogView);
        builder.setTitle("Note Settings");

        Spinner fontSizeSpinner = dialogView.findViewById(R.id.spinnerFontSize);
        RadioGroup fontStyleRadioGroup = dialogView.findViewById(R.id.radioGroupFontStyle);
        Button buttonColorDefault = dialogView.findViewById(R.id.buttonColorDefault);
        Button buttonColorLightYellow = dialogView.findViewById(R.id.buttonColorLightYellow);
        Button buttonColorLightBlue = dialogView.findViewById(R.id.buttonColorLightBlue);

        ArrayAdapter<CharSequence> adapter = ArrayAdapter.createFromResource(this,
                R.array.font_sizes_array, android.R.layout.simple_spinner_item);
        adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item);
        fontSizeSpinner.setAdapter(adapter);

        float currentFontSize = sharedPreferences.getFloat(PREF_FONT_SIZE, 18f);
        String[] fontSizesStringArray = getResources().getStringArray(R.array.font_sizes_array);
        for (int i = 0; i < fontSizesStringArray.length; i++) {
            if (fontSizesStringArray[i] != null && Float.parseFloat(fontSizesStringArray[i]) == currentFontSize) {
                fontSizeSpinner.setSelection(i);
                break;
            }
        }
        int currentStyle = sharedPreferences.getInt(PREF_FONT_STYLE, Typeface.NORMAL);
        if (currentStyle == Typeface.BOLD) fontStyleRadioGroup.check(R.id.radioBold);
        else if (currentStyle == Typeface.ITALIC) fontStyleRadioGroup.check(R.id.radioItalic);
        else fontStyleRadioGroup.check(R.id.radioNormal);

        builder.setPositiveButton("Apply", (dialog, which) -> {
            SharedPreferences.Editor editor = sharedPreferences.edit();
            if (fontSizeSpinner.getSelectedItem() != null) {
                String selectedFontSizeStr = fontSizeSpinner.getSelectedItem().toString();
                editor.putFloat(PREF_FONT_SIZE, Float.parseFloat(selectedFontSizeStr));
            }
            int selectedStyleId = fontStyleRadioGroup.getCheckedRadioButtonId();
            if (selectedStyleId == R.id.radioBold) editor.putInt(PREF_FONT_STYLE, Typeface.BOLD);
            else if (selectedStyleId == R.id.radioItalic) editor.putInt(PREF_FONT_STYLE, Typeface.ITALIC);
            else editor.putInt(PREF_FONT_STYLE, Typeface.NORMAL);
            editor.apply();
            loadAndApplyPreferences();
            Toast.makeText(this, "Settings Applied", Toast.LENGTH_SHORT).show();
        });
        builder.setNegativeButton("Cancel", null);
        AlertDialog dialog = builder.create();
        SharedPreferences.Editor editorForColor = sharedPreferences.edit();
        buttonColorDefault.setOnClickListener(v -> {
            TypedValue tv = new TypedValue();
            getTheme().resolveAttribute(android.R.attr.colorBackground, tv, true);
            editorForColor.putInt(PREF_BG_COLOR, tv.data).apply();
            loadAndApplyPreferences();
            dialog.dismiss(); // Dismiss dialog after applying color
        });
        buttonColorLightYellow.setOnClickListener(v -> {
            editorForColor.putInt(PREF_BG_COLOR, ContextCompat.getColor(this, R.color.md_theme_primaryContainer)).apply(); // Using a theme color
            loadAndApplyPreferences();
            dialog.dismiss();
        });
        buttonColorLightBlue.setOnClickListener(v -> {
            editorForColor.putInt(PREF_BG_COLOR, ContextCompat.getColor(this, R.color.light_blue_200)).apply(); // Using another defined color
            loadAndApplyPreferences();
            dialog.dismiss();
        });
        dialog.show();
    }

    // In NoteActivity.java
    private void sendWidgetUpdateBroadcast(String updatedNoteId) {
        if (updatedNoteId == null || updatedNoteId.trim().isEmpty()) {
            Log.w(TAG, "sendWidgetUpdateBroadcast: updatedNoteId is null or empty.");
            return;
        }
        Log.d(TAG, "Attempting to notify service about update for noteId: " + updatedNoteId);

        // We need to find which appWidgetIds are configured for *this* updatedNoteId
        // and then tell the service to refresh them (or the service can be smart enough
        // to already be listening and will update automatically).
        // A simpler approach is to tell the service to specifically re-evaluate this note.

        AppWidgetManager widgetManager = AppWidgetManager.getInstance(getApplicationContext());
        ComponentName thisWidgetProvider = new ComponentName(getApplicationContext(), NoteWidgetProvider.class);
        int[] allWidgetIds = widgetManager.getAppWidgetIds(thisWidgetProvider);

        if (allWidgetIds != null && allWidgetIds.length > 0) {
            for (int appWidgetId : allWidgetIds) {
                String configuredNoteId = NoteWidgetConfigureActivity.loadFirebaseNoteIdPref(this, appWidgetId);
                if (updatedNoteId.equals(configuredNoteId)) {
                    Log.d(TAG, "Found widget " + appWidgetId + " configured for updated note " + updatedNoteId + ". Notifying service.");
                    Intent serviceIntent = new Intent(this, WidgetUpdateService.class);
                    // The service's existing Firebase listener for this noteId should automatically pick up the change.
                    // However, if you want to be explicit or if there are timing issues, you could send a specific action.
                    // For now, let's assume the service's listener will handle it.
                    // If direct re-trigger is needed:
                    // serviceIntent.setAction(WidgetUpdateService.ACTION_START_LISTENING); // This will re-attach listener
                    // serviceIntent.putExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, appWidgetId);
                    // serviceIntent.putExtra(NoteActivity.EXTRA_NOTE_ID, updatedNoteId);
                    // try {
                    //     ContextCompat.startForegroundService(this, serviceIntent);
                    // } catch (Exception e) {
                    //    Log.e(TAG, "Error sending START_LISTENING to service from sendWidgetUpdateBroadcast", e);
                    // }

                    // A more direct way is to just update this specific widget view using the provider's static method
                    // This doesn't rely on the service for this immediate update after local save.
                    // The service will catch up anyway due to Firebase listener.
                    // This needs the actual note data, which you might not have immediately here,
                    // so relying on service's listener is cleaner.

                    // Forcing an update through the provider's onUpdate path might be an alternative
                    // if you want to ensure an immediate visual refresh without complex service interaction here.
                    Intent updateIntent = new Intent(this, NoteWidgetProvider.class);
                    updateIntent.setAction(AppWidgetManager.ACTION_APPWIDGET_UPDATE);
                    updateIntent.putExtra(AppWidgetManager.EXTRA_APPWIDGET_IDS, new int[]{appWidgetId});
                    sendBroadcast(updateIntent);
                    Log.i(TAG, "Sent ACTION_APPWIDGET_UPDATE for widget " + appWidgetId + " for note " + updatedNoteId);

                }
            }
        } else {
            Log.d(TAG, "No widget instances of this provider found to update.");
        }
    }
